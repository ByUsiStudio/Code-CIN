// Code CIN 官方标准库: 轻量测试断言 (test)
// 用法: import "test.cin"
// 说明: 提供计数器与断言; 结束时调用 t_report() 输出汇总 (返回失败数)。

// 通过 / 失败计数 (全局)
int T_PASS = 0
int T_FAIL = 0

// 断言两个整数相等
function t_eq_int(int got, int want, string label) -> int {
    if (got == want) {
        T_PASS = T_PASS + 1
        return 1
    }
    T_FAIL = T_FAIL + 1
    println("FAIL " + label + ": got=" + int_to_str(got) + " want=" + int_to_str(want))
    return 0
}

// 断言两个字符串相等
function t_eq_str(string got, string want, string label) -> int {
    if (strcmp(got, want) == 0) {
        T_PASS = T_PASS + 1
        return 1
    }
    T_FAIL = T_FAIL + 1
    println("FAIL " + label + ": got=[" + got + "] want=[" + want + "]")
    return 0
}

// 断言浮点近似相等 (容差 eps)
function t_near(float got, float want, float eps, string label) -> int {
    float d = got - want
    if (d < 0.0) { d = -d }
    if (d <= eps) {
        T_PASS = T_PASS + 1
        return 1
    }
    T_FAIL = T_FAIL + 1
    println("FAIL " + label + ": got=" + float_to_str(got) + " want=" + float_to_str(want))
    return 0
}

// 断言条件为真
function t_true(int cond, string label) -> int {
    if (cond != 0) {
        T_PASS = T_PASS + 1
        return 1
    }
    T_FAIL = T_FAIL + 1
    println("FAIL " + label + ": condition false")
    return 0
}

// 断言条件为假
function t_false(int cond, string label) -> int {
    return t_true(cond == 0, label)
}

// 重置计数
function t_reset() -> void {
    T_PASS = 0
    T_FAIL = 0
}

// 输出汇总, 返回失败数
function t_report() -> int {
    if (T_FAIL == 0) {
        println("OK: " + int_to_str(T_PASS) + " assertions passed")
    } else {
        println("FAILED: " + int_to_str(T_FAIL) + " of " + int_to_str(T_PASS + T_FAIL))
    }
    return T_FAIL
}

// ==================== 断言扩展 ====================

// 断言浮点近似相等 (绝对容差 1e-9; 需要更大容差请用 t_near)
function t_eq_float(float got, float want, string label) -> int {
    float d = got - want
    if (d < 0.0) { d = -d }
    if (d <= 0.000000001) {
        T_PASS = T_PASS + 1
        return 1
    }
    T_FAIL = T_FAIL + 1
    println("FAIL " + label + ": got=" + float_to_str(got) + " want=" + float_to_str(want))
    return 0
}

// 断言两个布尔值相等 (非 0 视为真)
function t_eq_bool(int got, int want, string label) -> int {
    int g = 0
    int w = 0
    if (got != 0) { g = 1 }
    if (want != 0) { w = 1 }
    if (g == w) {
        T_PASS = T_PASS + 1
        return 1
    }
    T_FAIL = T_FAIL + 1
    println("FAIL " + label + ": got=" + int_to_str(g) + " want=" + int_to_str(w))
    return 0
}

// 断言 got > want
function t_gt(int got, int want, string label) -> int {
    if (got > want) {
        T_PASS = T_PASS + 1
        return 1
    }
    T_FAIL = T_FAIL + 1
    println("FAIL " + label + ": got=" + int_to_str(got) + " want> " + int_to_str(want))
    return 0
}

// 断言 got < want
function t_lt(int got, int want, string label) -> int {
    if (got < want) {
        T_PASS = T_PASS + 1
        return 1
    }
    T_FAIL = T_FAIL + 1
    println("FAIL " + label + ": got=" + int_to_str(got) + " want< " + int_to_str(want))
    return 0
}

// 无条件失败 (用于尚未实现的占位断言)
function t_fail(string label) -> int {
    T_FAIL = T_FAIL + 1
    println("FAIL " + label + ": asserted failure")
    return 0
}

// 输出分组标题 (只打印, 不计入通过/失败数)
function t_case(string name) -> void {
    println("== " + name + " ==")
}
