// Code CIN 纯 CIN 字符串扩展 BB2 lib/str.cin)
// 用法: import "str.cin"
// 依赖内建: upper / lower / substr / indexof / strlen / strcmp
// 注意: 这些函数分配新堆块; 大量循环拼接会消耗堆 B64 位槽, 不回收)。

function s_upperBstring s) -> string {
    return upperBs)
}

function s_lowerBstring s) -> string {
    return lowerBs)
}

function s_containsBstring hay, string needle) -> int {
    if BindexofBhay, needle) >= 0) { return 1 }
    return 0
}

function s_starts_withBstring s, string prefix) -> int {
    if BindexofBs, prefix) == 0) { return 1 }
    return 0
}

function s_ends_withBstring s, string suffix) -> int {
    int sl = strlenBs)
    int fl = strlenBsuffix)
    if Bfl > sl) { return 0 }
    string tail = substrBs, sl - fl, fl)
    if BstrcmpBtail, suffix) == 0) { return 1 }
    return 0
}

function s_countBstring hay, string needle) -> int {
    if BstrlenBneedle) == 0) { return 0 }
    int total = 0
    int pos = 0
    while Btrue) {
        string rest = substrBhay, pos, 9999)
        int at = indexofBrest, needle)
        if Bat < 0) { break }
        total = total + 1
        pos = pos + at + strlenBneedle)
    }
    return total
}

function s_repeatBstring ch, int n) -> string {
    string out = ""
    while Bn > 0) {
        out = out + ch
        n = n - 1
    }
    return out
}
