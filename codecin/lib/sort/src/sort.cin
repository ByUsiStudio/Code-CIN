// Code CIN 官方标准库: 排序与查找 (sort)
// 用法: import "sort.cin"

// 归并排序的临时缓冲区 (库作用域, 供 sort_merge 使用)
int sort_tmp[256]

// 是否已升序有序
function sort_is_sorted(int[] a, int n) -> int {
    for (int i = 1; i < n; i = i + 1) {
        if (a[i - 1] > a[i]) { return 0 }
    }
    return 1
}

// 冒泡排序 (原地, 升序)
function sort_bubble(int[] a, int n) -> void {
    for (int i = 0; i < n - 1; i = i + 1) {
        for (int j = 0; j < n - 1 - i; j = j + 1) {
            if (a[j] > a[j + 1]) {
                int t = a[j]
                a[j] = a[j + 1]
                a[j + 1] = t
            }
        }
    }
}

// 选择排序 (原地, 升序)
function sort_selection(int[] a, int n) -> void {
    for (int i = 0; i < n - 1; i = i + 1) {
        int k = i
        for (int j = i + 1; j < n; j = j + 1) {
            if (a[j] < a[k]) { k = j }
        }
        if (k != i) {
            int t = a[i]
            a[i] = a[k]
            a[k] = t
        }
    }
}

// 插入排序 (原地, 升序)
function sort_insertion(int[] a, int n) -> void {
    for (int i = 1; i < n; i = i + 1) {
        int key = a[i]
        int j = i - 1
        while (j >= 0 && a[j] > key) {
            a[j + 1] = a[j]
            j = j - 1
        }
        a[j + 1] = key
    }
}

// 快速排序区间 [lo, hi] (原地, 升序)
function sort_quick(int[] a, int lo, int hi) -> void {
    if (lo >= hi) { return }
    int pivot = a[idiv(lo + hi, 2)]
    int i = lo
    int j = hi
    while (i <= j) {
        while (a[i] < pivot) { i = i + 1 }
        while (a[j] > pivot) { j = j - 1 }
        if (i <= j) {
            int t = a[i]
            a[i] = a[j]
            a[j] = t
            i = i + 1
            j = j - 1
        }
    }
    if (lo < j) { sort_quick(a, lo, j) }
    if (i < hi) { sort_quick(a, i, hi) }
}

// 快速排序整体入口
function sort_quick_all(int[] a, int n) -> void {
    if (n > 1) { sort_quick(a, 0, n - 1) }
}

// 二分查找 (数组需已升序), 返回下标或 -1
function bin_search(int[] a, int n, int v) -> int {
    int lo = 0
    int hi = n - 1
    while (lo <= hi) {
        int mid = idiv(lo + hi, 2)
        if (a[mid] == v) { return mid }
        if (a[mid] < v) {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return -1
}

// 自底向上归并排序 (原地, 升序); n > 256 时退化为插入排序
function sort_merge(int[] a, int n) -> void {
    if (n <= 1) { return }
    if (n > 256) {
        sort_insertion(a, n)
        return
    }
    int width = 1
    while (width < n) {
        int lo = 0
        while (lo < n) {
            int mid = lo + width
            if (mid > n) { mid = n }
            int hi = mid + width
            if (hi > n) { hi = n }
            int i = lo
            int j = mid
            int k = lo
            while (i < mid && j < hi) {
                if (a[i] <= a[j]) {
                    sort_tmp[k] = a[i]
                    i = i + 1
                } else {
                    sort_tmp[k] = a[j]
                    j = j + 1
                }
                k = k + 1
            }
            while (i < mid) {
                sort_tmp[k] = a[i]
                i = i + 1
                k = k + 1
            }
            while (j < hi) {
                sort_tmp[k] = a[j]
                j = j + 1
                k = k + 1
            }
            for (int t = lo; t < hi; t = t + 1) { a[t] = sort_tmp[t] }
            lo = lo + width * 2
        }
        width = width * 2
    }
}

// 堆排序 (原地, 升序); 不依赖 heap.cin
function sort_heap(int[] a, int n) -> void {
    if (n <= 1) { return }
    for (int i = idiv(n, 2) - 1; i >= 0; i = i - 1) {
        int root1 = i
        int done1 = 0
        while (done1 == 0) {
            int l = 2 * root1 + 1
            int r = 2 * root1 + 2
            int best = root1
            if (l < n && a[l] > a[best]) { best = l }
            if (r < n && a[r] > a[best]) { best = r }
            if (best == root1) {
                done1 = 1
            } else {
                int t1 = a[root1]
                a[root1] = a[best]
                a[best] = t1
                root1 = best
            }
        }
    }
    for (int end = n - 1; end > 0; end = end - 1) {
        int t2 = a[0]
        a[0] = a[end]
        a[end] = t2
        int root2 = 0
        int done2 = 0
        while (done2 == 0) {
            int l = 2 * root2 + 1
            int r = 2 * root2 + 2
            int best = root2
            if (l < end && a[l] > a[best]) { best = l }
            if (r < end && a[r] > a[best]) { best = r }
            if (best == root2) {
                done2 = 1
            } else {
                int t3 = a[root2]
                a[root2] = a[best]
                a[best] = t3
                root2 = best
            }
        }
    }
}

// 降序排序 (先升序再整体反转, 原地)
function sort_desc(int[] a, int n) -> void {
    if (n <= 1) { return }
    sort_quick_all(a, n)
    int i = 0
    int j = n - 1
    while (i < j) {
        int t = a[i]
        a[i] = a[j]
        a[j] = t
        i = i + 1
        j = j - 1
    }
}

// 对区间 [lo, hi) 升序排序 (原地, 越界下标自动钳制)
function sort_range(int[] a, int lo, int hi) -> void {
    if (lo < 0) { lo = 0 }
    if (hi <= lo) { return }
    sort_quick(a, lo, hi - 1)
}

// 首个 >= v 的下标 (数组需升序); 全部 < v 时返回 n
function bin_lower_bound(int[] a, int n, int v) -> int {
    int lo = 0
    int hi = n
    while (lo < hi) {
        int mid = idiv(lo + hi, 2)
        if (a[mid] < v) {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo
}

// 首个 > v 的下标 (数组需升序); 全部 <= v 时返回 n
function bin_upper_bound(int[] a, int n, int v) -> int {
    int lo = 0
    int hi = n
    while (lo < hi) {
        int mid = idiv(lo + hi, 2)
        if (a[mid] <= v) {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo
}
