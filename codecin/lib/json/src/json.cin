// Code CIN 官方标准库: 极简 JSON 取值 (json)
// 用法: import "json.cin"
// 说明: 面向扁平对象 (Termux API 等返回的 JSON), 不做完整语法解析。
//       支持 "key": value 的字符串/数字/布尔/空值提取。

// 取 key 对应的原始片段 (字符串去引号; 数字/布尔原样; 找不到返回 "")
function j_raw(string json, string key) -> string {
    string pat = "\"" + key + "\""
    int p = indexof(json, pat)
    if (p < 0) { return "" }
    int after = p + strlen(pat)
    string rest = substr(json, after, 9999)
    int q = indexof(rest, ":")
    if (q < 0) { return "" }
    int n = strlen(json)
    int start = after + q + 1
    // 跳过空白
    while (start < n && (json[start] == 32 || json[start] == 9 || json[start] == 10 || json[start] == 13)) {
        start = start + 1
    }
    if (start >= n) { return "" }
    if (json[start] == 34) {
        // 字符串值
        int end = start + 1
        while (end < n && json[end] != 34) { end = end + 1 }
        return substr(json, start + 1, end - start - 1)
    }
    // 数字 / true / false / null
    int end = start
    while (end < n && json[end] != 44 && json[end] != 125) { end = end + 1 }
    return trim(substr(json, start, end - start))
}

// 取字符串字段
function j_str(string json, string key) -> string {
    return j_raw(json, key)
}

// 取整数字段 (无法解析为 0)
function j_int(string json, string key) -> int {
    return atoi(j_raw(json, key))
}

// 取浮点字段 (支持可选负号与小数; 无法解析为 0.0)
function j_float(string json, string key) -> float {
    string s = j_raw(json, key)
    int n = strlen(s)
    int i = 0
    int neg = 0
    if (i < n && s[i] == 45) {
        neg = 1
        i = i + 1
    }
    float v = 0.0
    while (i < n && s[i] >= 48 && s[i] <= 57) {
        v = v * 10.0 + (s[i] - 48)
        i = i + 1
    }
    if (i < n && s[i] == 46) {
        i = i + 1
        float scale = 0.1
        while (i < n && s[i] >= 48 && s[i] <= 57) {
            v = v + (s[i] - 48) * scale
            scale = scale * 0.1
            i = i + 1
        }
    }
    if (neg == 1) { return -v }
    return v
}

// 是否包含 key
function j_has(string json, string key) -> int {
    if (indexof(json, "\"" + key + "\"") >= 0) { return 1 }
    return 0
}

// 取布尔字段 (true/1 为 1, 否则 0)
function j_bool(string json, string key) -> int {
    string v = j_raw(json, key)
    if (strcmp(v, "true") == 0) { return 1 }
    if (strcmp(v, "1") == 0) { return 1 }
    return 0
}

// ---------------- 生成 / 数组统计 (新增) ----------------
// 生成函数只做**字符串拼装**, 不校验输入结构; 数组函数按**扁平/含嵌套**的
// 文本扫描, 能正确跳过字符串内的逗号与嵌套的 [] {}。
// 所有长度都是字节语义; 拼接会产生不回收的堆块。

// JSON 字符串转义 (不含外层引号): " \ 与控制字符 (0..31) 转义,
// 其中 8/9/10/12/13 用 \b \t \n \f \r, 其余控制字符用 \u00XX (小写十六进制)。
// >= 32 的字节原样保留 (UTF-8 多字节字符可安全通过)
function j_escape(string s) -> string {
    int n = strlen(s)
    string out = ""
    int seg = 0
    for (int i = 0; i < n; i = i + 1) {
        int c = s[i]
        string rep = ""
        if (c == 34) {
            rep = "\\\""
        } else if (c == 92) {
            rep = "\\\\"
        } else if (c == 8) {
            rep = "\\b"
        } else if (c == 9) {
            rep = "\\t"
        } else if (c == 10) {
            rep = "\\n"
        } else if (c == 12) {
            rep = "\\f"
        } else if (c == 13) {
            rep = "\\r"
        } else if (c < 32) {
            rep = "\\u00" + substr("0123456789abcdef", c >> 4, 1) + substr("0123456789abcdef", c & 15, 1)
        }
        if (strlen(rep) > 0) {
            out = out + substr(s, seg, i - seg) + rep
            seg = i + 1
        }
    }
    return out + substr(s, seg, n - seg)
}

// 单成员 JSON 对象 (字符串值): j_obj("k", "a\"b") -> "{\"k\":\"a\\\"b\"}"
function j_obj(string key, string value) -> string {
    return "{\"" + j_escape(key) + "\":\"" + j_escape(value) + "\"}"
}

// 单成员 JSON 对象 (原始值): raw 必须是合法 JSON 片段 (数字/true/false/null/数组/对象)
// j_obj_raw("n", "42") -> "{\"n\":42}"
function j_obj_raw(string key, string raw) -> string {
    return "{\"" + j_escape(key) + "\":" + raw + "}"
}

// 整数 -> JSON 数字字面量 (十进制; 负数带 '-')
function j_num(int v) -> string {
    return int_to_str(v)
}

// 数组元素个数 (支持嵌套 [] {} 与字符串内逗号); 找不到 '[' 或空数组返回 0。
// j_arr_len("[1, 2, 3]") == 3; j_arr_len("[]") == 0;
// j_arr_len("[\"a,b\", [1,2]]") == 2
function j_arr_len(string a) -> int {
    int n = strlen(a)
    int open = -1
    for (int i = 0; i < n; i = i + 1) {
        if (a[i] == 91) {
            open = i
            break
        }
    }
    if (open < 0) { return 0 }
    int depth = 1
    int in_str = 0
    int esc = 0
    int count = 0
    int has = 0
    int i = open + 1
    while (i < n) {
        int c = a[i]
        if (in_str == 1) {
            if (esc == 1) {
                esc = 0
            } else if (c == 92) {
                esc = 1
            } else if (c == 34) {
                in_str = 0
            }
            i = i + 1
            continue
        }
        if (c == 34) {
            has = 1
            in_str = 1
            i = i + 1
            continue
        }
        if (c == 91 || c == 123) {
            has = 1
            depth = depth + 1
            i = i + 1
            continue
        }
        if (c == 93 || c == 125) {
            if (depth == 1) {
                if (has == 1) { count = count + 1 }
                break
            }
            depth = depth - 1
            i = i + 1
            continue
        }
        if (c == 44) {
            if (depth == 1) {
                if (has == 1) {
                    count = count + 1
                    has = 0
                }
            }
            i = i + 1
            continue
        }
        if (c == 32 || c == 9 || c == 10 || c == 13) {
            i = i + 1
            continue
        }
        has = 1
        i = i + 1
    }
    return count
}

// 取数组第 idx 个元素的原始 JSON 片段 (已 trim, 不递归解析); 越界或非数组返回 ""。
// j_arr_get("[10, \"a,b\", [1,2]]", 1) == "\"a,b\""
function j_arr_get(string a, int idx) -> string {
    if (idx < 0) { return "" }
    int n = strlen(a)
    int open = -1
    for (int i = 0; i < n; i = i + 1) {
        if (a[i] == 91) {
            open = i
            break
        }
    }
    if (open < 0) { return "" }
    int depth = 1
    int in_str = 0
    int esc = 0
    int cur = 0
    int start = -1
    int i = open + 1
    while (i < n) {
        int c = a[i]
        if (in_str == 1) {
            if (esc == 1) {
                esc = 0
            } else if (c == 92) {
                esc = 1
            } else if (c == 34) {
                in_str = 0
            }
            i = i + 1
            continue
        }
        if (c == 34) {
            if (depth == 1 && start < 0) { start = i }
            in_str = 1
            i = i + 1
            continue
        }
        if (c == 91 || c == 123) {
            if (depth == 1 && start < 0) { start = i }
            depth = depth + 1
            i = i + 1
            continue
        }
        if (c == 93 || c == 125) {
            if (depth == 1) {
                if (cur == idx) {
                    if (start < 0) { return "" }
                    return trim(substr(a, start, i - start))
                }
                break
            }
            depth = depth - 1
            i = i + 1
            continue
        }
        if (c == 44) {
            if (depth == 1) {
                if (cur == idx) {
                    if (start < 0) { return "" }
                    return trim(substr(a, start, i - start))
                }
                cur = cur + 1
                start = -1
            }
            i = i + 1
            continue
        }
        if (c == 32 || c == 9 || c == 10 || c == 13) {
            i = i + 1
            continue
        }
        if (depth == 1 && start < 0) { start = i }
        i = i + 1
    }
    return ""
}
