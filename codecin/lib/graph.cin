// Code CIN 官方标准库: 定长图 (graph)
// 用法: import "graph.cin"
//
// 纯 CIN 实现, 不使用任何宿主能力内建, 也不做动态内存分配:
// 图存放在库内全局**定长邻接矩阵**里 (行主序一维数组), 节点容量上限
// GRAPH_MAX = 16, 边权是 int。
//
// 容量上限:
//   GRAPH_MAX = 16 个节点 (顶点编号 0..graph_nodes()-1)
//   邻接矩阵 16 x 16 = 256 个格子 (边与权重各一份)
//
// 全局数据段占用 (每槽 8 字节):
//   graph_edge[256] + graph_w[256]                     = 512 槽
//   graph_seen[16] + graph_queue[16] + graph_stack[16] =  48 槽
//   graph_indeg[16]                                    =  16 槽
//   标量 (graph_n / graph_dir / graph_cnt)              =   3 槽
//   合计 579 槽 = 4632 字节, 远小于默认 64 KiB 数据段。
//
// 语义说明:
//   * 库内只有一份全局实例, 同一程序内共享; 需要多张图请用 struct 自行封装;
//   * 节点编号越界 (负数或 >= graph_nodes()) 一律返回明确失败值, 不会静默写内存:
//     graph_has_edge / graph_weight 返回 0, graph_degree / graph_in_degree 返回 -1,
//     graph_add_edge / graph_topo_order 走失败分支 (0 / -1), graph_bfs / graph_dfs /
//     graph_dijkstra 返回 0 且不写输出数组;
//   * 边是否存在单独记录在 graph_edge 里, 因此**权重可以是 0 或负数**:
//     判断边是否存在一律用 graph_has_edge, 不要用 graph_weight != 0;
//   * graph_reset(n, directed) 的 n <= 0 钳制为 0, n > GRAPH_MAX 钳制为 GRAPH_MAX;
//   * 无向图里 (u, v) 与 (v, u) 是同一条边 (加边时两侧同时写入), 有向图按 u -> v;
//   * 自环 (u == v) 允许存在: 无向图里只算一条边, 也只贡献 1 度;
//   * 重复加同一条边返回 0 (邻接矩阵不支持平行边);
//   * 所有遍历/最短路都以**节点编号升序**扫描邻居, 因此结果完全确定;
//   * graph_dijkstra 要求边权 >= 0; 出现负权时"松弛结果 < 0"的边会被忽略
//     (不报错, 此时最短距离没有保证)。

const int GRAPH_MAX = 16

int graph_edge[GRAPH_MAX * GRAPH_MAX]
int graph_w[GRAPH_MAX * GRAPH_MAX]

// 遍历用的内部工作区 (BFS 队列 / DFS 栈 / 访问标记 / 入度)
int graph_seen[GRAPH_MAX]
int graph_queue[GRAPH_MAX]
int graph_stack[GRAPH_MAX]
int graph_indeg[GRAPH_MAX]

int graph_n = 0
int graph_dir = 0
int graph_cnt = 0

// ---------------- 状态查询 ----------------

// 容量上限 (节点数), 固定返回 GRAPH_MAX = 16
function graph_max() -> int {
    return GRAPH_MAX
}

// 当前节点数 (graph_reset 设定的值, 已经过钳制)
function graph_nodes() -> int {
    return graph_n
}

// 是否为有向图: 1 有向, 0 无向
function graph_is_directed() -> int {
    return graph_dir
}

// 当前边数; 无向图里 (u, v) 与 (v, u) 只算一条
function graph_edge_count() -> int {
    return graph_cnt
}

// ---------------- 生命周期 ----------------

// 重新设定节点数与方向, 并把所有边清空
// n <= 0 钳制为 0; n > GRAPH_MAX 钳制为 GRAPH_MAX; directed 非零表示有向图
function graph_reset(int n, int directed) -> void {
    int k = n
    if (k < 0) { k = 0 }
    if (k > GRAPH_MAX) { k = GRAPH_MAX }
    graph_n = k
    if (directed) {
        graph_dir = 1
    } else {
        graph_dir = 0
    }
    graph_clear()
}

// 删除所有边, **保留**节点数与有向标志
function graph_clear() -> void {
    for (int i = 0; i < GRAPH_MAX * GRAPH_MAX; i = i + 1) {
        graph_edge[i] = 0
        graph_w[i] = 0
    }
    graph_cnt = 0
}

// ---------------- 内部辅助 ----------------

// 内部辅助: 节点编号 u 是否合法
function graph_aux_node(int u) -> int {
    if (u < 0 || u >= graph_n) { return 0 }
    return 1
}

// 内部辅助: 无向视角下 u 与 v 之间是否有边 (有向图取两个方向的并集)
function graph_aux_arc(int u, int v) -> int {
    if (graph_edge[u * GRAPH_MAX + v] == 1) { return 1 }
    if (graph_edge[v * GRAPH_MAX + u] == 1) { return 1 }
    return 0
}

// ---------------- 边 ----------------

// 加边 u -> v (无向图则两侧都加), 权重 w
// 成功返回 1; 节点越界或这条边已存在返回 0 (状态不变)
function graph_add_edge(int u, int v, int w) -> int {
    if (graph_aux_node(u) == 0 || graph_aux_node(v) == 0) { return 0 }
    if (graph_edge[u * GRAPH_MAX + v] == 1) { return 0 }
    graph_edge[u * GRAPH_MAX + v] = 1
    graph_w[u * GRAPH_MAX + v] = w
    if (graph_dir == 0) {
        graph_edge[v * GRAPH_MAX + u] = 1
        graph_w[v * GRAPH_MAX + u] = w
    }
    graph_cnt = graph_cnt + 1
    return 1
}

// u 到 v 是否存在边, 1/0; 节点越界返回 0
function graph_has_edge(int u, int v) -> int {
    if (graph_aux_node(u) == 0 || graph_aux_node(v) == 0) { return 0 }
    return graph_edge[u * GRAPH_MAX + v]
}

// 边 u -> v 的权重; 无这条边或节点越界返回 0
// 权重本身可以是 0, 所以判断"有没有边"请用 graph_has_edge
function graph_weight(int u, int v) -> int {
    if (graph_has_edge(u, v) == 0) { return 0 }
    return graph_w[u * GRAPH_MAX + v]
}

// 出度 (无向图就是邻居数, 自环算 1); 节点越界返回 -1
function graph_degree(int u) -> int {
    if (graph_aux_node(u) == 0) { return -1 }
    int d = 0
    for (int v = 0; v < graph_n; v = v + 1) {
        if (graph_edge[u * GRAPH_MAX + v] == 1) { d = d + 1 }
    }
    return d
}

// 入度 (无向图与 graph_degree 相同, 自环算 1); 节点越界返回 -1
function graph_in_degree(int u) -> int {
    if (graph_aux_node(u) == 0) { return -1 }
    int d = 0
    for (int v = 0; v < graph_n; v = v + 1) {
        if (graph_edge[v * GRAPH_MAX + u] == 1) { d = d + 1 }
    }
    return d
}

// ---------------- 遍历 ----------------

// 从 start 出发的广度优先遍历 (按出边方向; 邻居按编号升序入队)
//   返回访问到的节点数 cnt;
//   order[0..cnt-1]  访问顺序;
//   out_dist[0..graph_n-1]  start 到各点的距离 (边数), 不可达写 -1;
//   start 越界或图为空: 返回 0, order 不写, out_dist 全部写 -1
function graph_bfs(int start, int[] order, int[] out_dist) -> int {
    for (int i = 0; i < graph_n; i = i + 1) {
        graph_seen[i] = 0
        out_dist[i] = -1
    }
    if (graph_aux_node(start) == 0) { return 0 }
    int head = 0
    int tail = 0
    graph_queue[tail] = start
    tail = tail + 1
    graph_seen[start] = 1
    out_dist[start] = 0
    int cnt = 0
    while (head < tail) {
        int u = graph_queue[head]
        head = head + 1
        order[cnt] = u
        cnt = cnt + 1
        for (int v = 0; v < graph_n; v = v + 1) {
            if (graph_edge[u * GRAPH_MAX + v] == 0) { continue }
            if (graph_seen[v] == 1) { continue }
            graph_seen[v] = 1
            out_dist[v] = out_dist[u] + 1
            graph_queue[tail] = v
            tail = tail + 1
        }
    }
    return cnt
}

// 从 start 出发的深度优先遍历 (**显式栈**, 不使用递归, 栈深不会随图增长)
//   返回访问到的节点数 cnt, order[0..cnt-1] 写入访问顺序;
//   邻居按编号**降序**压栈, 因此编号小的邻居先被访问到;
//   start 越界或图为空返回 0 (order 不写)
function graph_dfs(int start, int[] order) -> int {
    for (int i = 0; i < graph_n; i = i + 1) {
        graph_seen[i] = 0
    }
    if (graph_aux_node(start) == 0) { return 0 }
    int sp = 0
    graph_stack[sp] = start
    sp = sp + 1
    graph_seen[start] = 1
    int cnt = 0
    while (sp > 0) {
        sp = sp - 1
        int u = graph_stack[sp]
        order[cnt] = u
        cnt = cnt + 1
        for (int v = graph_n - 1; v >= 0; v = v - 1) {
            if (graph_edge[u * GRAPH_MAX + v] == 0) { continue }
            if (graph_seen[v] == 1) { continue }
            graph_seen[v] = 1
            graph_stack[sp] = v
            sp = sp + 1
        }
    }
    return cnt
}

// ---------------- 连通性 ----------------

// 连通分量个数 (按**无向视角**统计; 有向图得到的是弱连通分量数)
//   空图返回 0, 每个孤立节点各算一个分量
function graph_component_count() -> int {
    int comps = 0
    for (int i = 0; i < graph_n; i = i + 1) {
        graph_seen[i] = 0
    }
    for (int s = 0; s < graph_n; s = s + 1) {
        if (graph_seen[s] == 1) { continue }
        comps = comps + 1
        int head = 0
        int tail = 0
        graph_queue[tail] = s
        tail = tail + 1
        graph_seen[s] = 1
        while (head < tail) {
            int u = graph_queue[head]
            head = head + 1
            for (int v = 0; v < graph_n; v = v + 1) {
                if (graph_aux_arc(u, v) == 0) { continue }
                if (graph_seen[v] == 1) { continue }
                graph_seen[v] = 1
                graph_queue[tail] = v
                tail = tail + 1
            }
        }
    }
    return comps
}

// 是否连通 (无向视角, 有向图问的是弱连通); 空图与单节点都返回 1
function graph_connected() -> int {
    if (graph_component_count() <= 1) { return 1 }
    return 0
}

// ---------------- 环与拓扑序 ----------------

// 是否存在环 (自环算环): 1/0; 空图返回 0
//   无向图判定式: 边数 > 节点数 - 连通分量数 (无平行边, 因此充要);
//   有向图: 拓扑排序能否覆盖全部节点
function graph_is_cyclic() -> int {
    if (graph_n <= 0) { return 0 }
    if (graph_dir == 1) {
        // 借 graph_stack 当拓扑序输出缓冲 (两者不会同时使用)
        if (graph_topo_order(graph_stack) != graph_n) { return 1 }
        return 0
    }
    if (graph_cnt > graph_n - graph_component_count()) { return 1 }
    return 0
}

// 有向图的拓扑排序 (Kahn: 反复取**编号最小**的入度 0 节点, 结果确定)
//   成功返回节点数, order[0..n-1] 写入拓扑序;
//   有环返回 -1 (order 只写入已确定的前缀);
//   无向图返回 -1 (无向图没有拓扑序); 空有向图返回 0
function graph_topo_order(int[] order) -> int {
    if (graph_dir == 0) { return -1 }
    if (graph_n <= 0) { return 0 }
    for (int i = 0; i < graph_n; i = i + 1) {
        graph_indeg[i] = 0
    }
    for (int u = 0; u < graph_n; u = u + 1) {
        for (int v = 0; v < graph_n; v = v + 1) {
            if (graph_edge[u * GRAPH_MAX + v] == 1) {
                graph_indeg[v] = graph_indeg[v] + 1
            }
        }
    }
    int cnt = 0
    for (int step = 0; step < graph_n; step = step + 1) {
        int pick = -1
        for (int i = 0; i < graph_n; i = i + 1) {
            if (graph_indeg[i] == 0) {
                pick = i
                break
            }
        }
        if (pick < 0) { break }
        order[cnt] = pick
        cnt = cnt + 1
        graph_indeg[pick] = -1
        for (int v = 0; v < graph_n; v = v + 1) {
            if (graph_edge[pick * GRAPH_MAX + v] == 1) {
                graph_indeg[v] = graph_indeg[v] - 1
            }
        }
    }
    if (cnt != graph_n) { return -1 }
    return cnt
}

// ---------------- 最短路 ----------------

// 单源最短路径 (Dijkstra, O(n^2) 邻接矩阵版)
//   dist[0..graph_n-1] 写入 src 到各点的最短距离, **不可达写 -1**;
//   返回可达节点数 (含 src 自身);
//   src 越界或图为空返回 0 且不写 dist;
//   有向图按出边方向松弛, 无向图两个方向都松弛;
//   要求边权 >= 0: 负权会让"松弛结果 < 0"的边被忽略, 此时结果没有保证
function graph_dijkstra(int src, int[] dist) -> int {
    if (graph_aux_node(src) == 0) { return 0 }
    for (int i = 0; i < graph_n; i = i + 1) {
        dist[i] = -1
        graph_seen[i] = 0
    }
    dist[src] = 0
    for (int step = 0; step < graph_n; step = step + 1) {
        int pick = -1
        int best = 0
        for (int i = 0; i < graph_n; i = i + 1) {
            if (graph_seen[i] == 1) { continue }
            if (dist[i] < 0) { continue }
            if (pick < 0 || dist[i] < best) {
                pick = i
                best = dist[i]
            }
        }
        if (pick < 0) { break }
        graph_seen[pick] = 1
        for (int v = 0; v < graph_n; v = v + 1) {
            if (graph_edge[pick * GRAPH_MAX + v] == 0) { continue }
            if (graph_seen[v] == 1) { continue }
            int nd = dist[pick] + graph_w[pick * GRAPH_MAX + v]
            if (nd < 0) { continue }
            if (dist[v] < 0 || nd < dist[v]) {
                dist[v] = nd
            }
        }
    }
    int cnt = 0
    for (int i = 0; i < graph_n; i = i + 1) {
        if (dist[i] >= 0) { cnt = cnt + 1 }
    }
    return cnt
}
