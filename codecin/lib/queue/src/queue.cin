// Code CIN 官方标准库: 队列与栈 (queue)
// 用法: import "queue.cin"
//
// 定长环形队列 (FIFO) 与定长栈 (LIFO), 使用库内全局状态,
// 因此同一程序内只保留一份实例; 需要多实例时请用 struct 自行封装。
// 容量上限 QUEUE_CAP / STACK_CAP = 64。

int queue_ring[64]
int queue_head = 0
int queue_tail = 0
int queue_len = 0

int stack_data[64]
int stack_len = 0

// ---------------- 环形队列 ----------------

function queue_capacity() -> int {
    return 64
}

function queue_clear() -> void {
    queue_head = 0
    queue_tail = 0
    queue_len = 0
}

function queue_size() -> int {
    return queue_len
}

function queue_is_empty() -> int {
    if (queue_len == 0) { return 1 }
    return 0
}

function queue_is_full() -> int {
    if (queue_len == 64) { return 1 }
    return 0
}

// 入队; 满时返回 0, 成功返回 1
function queue_push(int v) -> int {
    if (queue_len == 64) { return 0 }
    queue_ring[queue_tail] = v
    queue_tail = (queue_tail + 1) % 64
    queue_len = queue_len + 1
    return 1
}

// 出队; 空时返回 0
function queue_pop() -> int {
    if (queue_len == 0) { return 0 }
    int v = queue_ring[queue_head]
    queue_head = (queue_head + 1) % 64
    queue_len = queue_len - 1
    return v
}

// 查看队首 (不出队)
function queue_front() -> int {
    if (queue_len == 0) { return 0 }
    return queue_ring[queue_head]
}

// 查看队尾
function queue_back() -> int {
    if (queue_len == 0) { return 0 }
    int idx = queue_tail - 1
    if (idx < 0) { idx = 63 }
    return queue_ring[idx]
}

// ---------------- 栈 ----------------

function stack_capacity() -> int {
    return 64
}

function stack_clear() -> void {
    stack_len = 0
}

function stack_size() -> int {
    return stack_len
}

function stack_is_empty() -> int {
    if (stack_len == 0) { return 1 }
    return 0
}

// 入栈; 满时返回 0, 成功返回 1
function stack_push(int v) -> int {
    if (stack_len == 64) { return 0 }
    stack_data[stack_len] = v
    stack_len = stack_len + 1
    return 1
}

// 出栈; 空时返回 0
function stack_pop() -> int {
    if (stack_len == 0) { return 0 }
    stack_len = stack_len - 1
    return stack_data[stack_len]
}

// 查看栈顶 (不出栈)
function stack_peek() -> int {
    if (stack_len == 0) { return 0 }
    return stack_data[stack_len - 1]
}

// ---------------- 追加: 按下标访问 / 旋转 / 反转 / 批量入队 ----------------

// 队列中第 k 个元素 (k = 0 是队首); k 越界或队列为空返回 0
function queue_peek_at(int k) -> int {
    if (k < 0 || k >= queue_len) { return 0 }
    return queue_ring[(queue_head + k) % 64]
}

// 循环左移 k 个位置 (k < 0 表示右移, |k| 按队列长度取模);
//   返回实际左移的元素个数 (0..queue_len-1), 空队列返回 0
function queue_rotate(int k) -> int {
    if (queue_len == 0) { return 0 }
    int n = queue_len
    int steps = k % n
    if (steps < 0) { steps = steps + n }
    for (int i = 0; i < steps; i = i + 1) {
        int v = queue_pop()
        queue_push(v)
    }
    return steps
}

// 反转队列 (队首与队尾互换); 空队列或单元素无操作
function queue_reverse() -> void {
    int n = queue_len
    for (int i = 0; i < idiv(n, 2); i = i + 1) {
        int x = (queue_head + i) % 64
        int y = (queue_head + n - 1 - i) % 64
        int t = queue_ring[x]
        queue_ring[x] = queue_ring[y]
        queue_ring[y] = t
    }
}

// 批量入队: 依次压入 vals[0..n-1], 队列满即停止; 返回成功入队的个数
function queue_push_all(int[] vals, int n) -> int {
    int c = 0
    for (int i = 0; i < n; i = i + 1) {
        if (queue_push(vals[i]) == 0) { break }
        c = c + 1
    }
    return c
}

// 第 k 个栈元素 (k = 0 是栈底, k = stack_size()-1 是栈顶);
//   k 越界或栈为空返回 0
function stack_peek_at(int k) -> int {
    if (k < 0 || k >= stack_len) { return 0 }
    return stack_data[k]
}

// 反转栈 (栈底变栈顶); 空栈或单元素无操作
function stack_reverse() -> void {
    for (int i = 0; i < idiv(stack_len, 2); i = i + 1) {
        int j = stack_len - 1 - i
        int t = stack_data[i]
        stack_data[i] = stack_data[j]
        stack_data[j] = t
    }
}
