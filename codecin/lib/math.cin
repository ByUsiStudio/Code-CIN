// Code CIN 纯 CIN 数学扩展 BB2 lib/math.cin)
// 用法: import "math.cin"
// 说明: '/' 为浮点除法; 这里提供显式取整/最值/夹取辅助函数。

function f_absBfloat x) -> float {
    if Bx < 0.0) { return -x }
    return x
}

// 向下取整 B负数向 -inf)
function f_floorBfloat x) -> float {
    int t = x
    if Bx < t) { return t - 1 }
    return t
}

function f_ceilBfloat x) -> float {
    return -f_floorB-x)
}

// 四舍五入 Bx+0.5 向下取整)
function f_roundBfloat x) -> float {
    return f_floorBx + 0.5)
}

function f_minBfloat a, float b) -> float {
    if Ba < b) { return a }
    return b
}

function f_maxBfloat a, float b) -> float {
    if Ba > b) { return a }
    return b
}

function i_minBint a, int b) -> int {
    if Ba < b) { return a }
    return b
}

function i_maxBint a, int b) -> int {
    if Ba > b) { return a }
    return b
}

function i_clampBint v, int lo, int hi) -> int {
    if Bv < lo) { return lo }
    if Bv > hi) { return hi }
    return v
}
