// Code CIN 官方标准库: 键盘输入监听便捷封装 (key)
// 用法: import "key.cin"
// 说明: 需真实终端 (管道 / 重定向下 get_key 恒为 -1, key_hit 恒为 0)。
//       首次调用会切换终端原始输入 (不回显), 程序退出自动恢复;
//       Ctrl+C 在此期间不再终止程序, 表现为键码 3 (K_CTRL(67))。

// 扩展键码 (与原生引擎一致; 0..255 为原始字节码)
enum Key {
    K_UP = 1001,
    K_DOWN = 1002,
    K_LEFT = 1003,
    K_RIGHT = 1004,
    K_HOME = 1005,
    K_END = 1006,
    K_PGUP = 1007,
    K_PGDN = 1008,
    K_INS = 1009,
    K_DEL = 1010,
    K_F1 = 1021,
    K_F2 = 1022,
    K_F3 = 1023,
    K_F4 = 1024,
    K_F5 = 1025,
    K_F6 = 1026,
    K_F7 = 1027,
    K_F8 = 1028,
    K_F9 = 1029,
    K_F10 = 1030,
    K_F11 = 1031,
    K_F12 = 1032,
    K_CTRL_UP = 1101,
    K_CTRL_DOWN = 1102,
    K_CTRL_LEFT = 1103,
    K_CTRL_RIGHT = 1104,
    K_SHIFT_UP = 1105,
    K_SHIFT_DOWN = 1106,
    K_SHIFT_LEFT = 1107,
    K_SHIFT_RIGHT = 1108,
    K_SHIFT_TAB = 1109,
    K_ESC = 27,
    K_ENTER = 13,
    K_TAB = 9,
    K_BACKSPACE = 8
}

// Ctrl 组合键码: k_ctrl('C') 即 Ctrl+C (3)
function k_ctrl(int c) -> int {
    return c & 0x1F
}

// 是否扩展键码 (方向键 / 功能键 / 修饰组合等, 非 0..255 原始字节)
function k_is_special(int code) -> int {
    if (code >= 1001 && code <= 1032) { return 1 }
    if (code >= 1101 && code <= 1109) { return 1 }
    return 0
}

// 是否功能键 F1..F12
function k_is_function(int code) -> int {
    if (code >= 1021 && code <= 1032) { return 1 }
    return 0
}

// 是否修饰键 + 方向键组合 (Ctrl/Shift + 方向)
function k_is_modified_arrow(int code) -> int {
    if (code >= 1101 && code <= 1108) { return 1 }
    return 0
}

// 阻塞等待一个按键 (内部 10ms 轮询 get_key)
function key_wait() -> int {
    while (1) {
        int k = get_key()
        if (k != -1) { return k }
        sleep_ms(10)
    }
    return -1
}

// ==================== 键位分类 / 命名 / 轮询扩展 ====================

// 是否方向键 (不含 Ctrl/Shift 组合, 组合见 k_is_modified_arrow)
function k_is_arrow(int code) -> int {
    if (code >= 1001 && code <= 1004) { return 1 }
    return 0
}

// 是否导航键 (方向键 / Home / End / PgUp / PgDn / Ins / Del)
function k_is_nav(int code) -> int {
    if (code >= 1001 && code <= 1010) { return 1 }
    return 0
}

// 是否回车 (K_ENTER 或换行字节 10)
function k_is_enter(int code) -> int {
    if (code == K_ENTER || code == 10) { return 1 }
    return 0
}

// 非阻塞轮询: 有键返回键码, 无键返回 -1 (不睡眠)
function key_poll() -> int {
    if (key_hit() == 0) { return -1 }
    return get_key()
}

// 私有: 字符码 -> 单字符字符串 (32..126 与 \t \n; 其余返回空串)
function _key_chr(int code) -> string {
    if (code == 10) { return "\n" }
    if (code == 9) { return "\t" }
    if (code < 32 || code > 126) { return "" }
    string all = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    return substr(all, code - 32, 1)
}

// 键码 -> 可读名称 (可打印 ASCII 返回该字符本身, 不认识的键返回 "")
function k_key_name(int code) -> string {
    if (code == 8) { return "Backspace" }
    if (code == 9) { return "Tab" }
    if (code == 10) { return "LF" }
    if (code == 13) { return "Enter" }
    if (code == 27) { return "Esc" }
    if (code == 32) { return "Space" }
    if (code == 1001) { return "Up" }
    if (code == 1002) { return "Down" }
    if (code == 1003) { return "Left" }
    if (code == 1004) { return "Right" }
    if (code == 1005) { return "Home" }
    if (code == 1006) { return "End" }
    if (code == 1007) { return "PgUp" }
    if (code == 1008) { return "PgDn" }
    if (code == 1009) { return "Ins" }
    if (code == 1010) { return "Del" }
    if (code >= 1021 && code <= 1032) { return "F" + int_to_str(code - 1020) }
    if (code == 1101) { return "Ctrl+Up" }
    if (code == 1102) { return "Ctrl+Down" }
    if (code == 1103) { return "Ctrl+Left" }
    if (code == 1104) { return "Ctrl+Right" }
    if (code == 1105) { return "Shift+Up" }
    if (code == 1106) { return "Shift+Down" }
    if (code == 1107) { return "Shift+Left" }
    if (code == 1108) { return "Shift+Right" }
    if (code == 1109) { return "Shift+Tab" }
    return _key_chr(code)
}
