// Code CIN 官方标准库: 位运算 (bits)
// 用法: import "lib/bits.cin"
//
// 说明: CIN 的 >> 是算术右移 (ASR), 对负数会补 1, 因此本库所有涉及负数
// 的位移都先做符号位/掩码处理, 保证结果与 64 位无符号语义一致。

// 64 位全 1 掩码
function bits_mask() -> int {
    return 0xFFFFFFFFFFFFFFFF
}

// 二进制中 1 的个数 (popcount, 含符号位)
function bits_popcount(int x) -> int {
    int n = 0
    if (x < 0) { n = 1 }
    int v = x & 0x7FFFFFFFFFFFFFFF
    while (v != 0) {
        n = n + (v & 1)
        v = v >> 1
    }
    return n
}

// 前导零个数 (按 64 位计); x == 0 返回 64
function bits_clz(int x) -> int {
    if (x < 0) { return 0 }
    if (x == 0) { return 64 }
    int n = 0
    int bit = 0x4000000000000000
    while (bit > 0 && (x & bit) == 0) {
        n = n + 1
        bit = bit >> 1
    }
    return n + 1
}

// 末尾零个数; x == 0 返回 64
function bits_ctz(int x) -> int {
    if (x == 0) { return 64 }
    int n = 0
    int v = x
    while ((v & 1) == 0) {
        n = n + 1
        v = v >> 1
    }
    return n
}

// 是否为 2 的幂 (仅正数)
function bits_is_pow2(int x) -> int {
    if (x <= 0) { return 0 }
    if ((x & (x - 1)) == 0) { return 1 }
    return 0
}

// 不小于 x 的最小 2 的幂 (x <= 1 返回 1)
function bits_next_pow2(int x) -> int {
    int p = 1
    while (p < x && p > 0) {
        p = p << 1
    }
    return p
}

// 读取第 i 位 (0..63)
function bits_test(int x, int i) -> int {
    if (i < 0 || i > 63) { return 0 }
    return (x >> i) & 1
}

// 置位 / 清位 / 取反某一位
function bits_set(int x, int i) -> int {
    if (i < 0 || i > 63) { return x }
    return x | (1 << i)
}

function bits_clear(int x, int i) -> int {
    if (i < 0 || i > 63) { return x }
    return x & ~(1 << i)
}

function bits_toggle(int x, int i) -> int {
    if (i < 0 || i > 63) { return x }
    return x ^ (1 << i)
}

// 循环左移 (n 自动对 64 取模)
function bits_rotl(int x, int n) -> int {
    int k = n % 64
    if (k < 0) { k = k + 64 }
    if (k == 0) { return x }
    int hi = (x >> (64 - k)) & ((1 << k) - 1)
    return (x << k) | hi
}

// 循环右移
function bits_rotr(int x, int n) -> int {
    int k = n % 64
    if (k < 0) { k = k + 64 }
    if (k == 0) { return x }
    return bits_rotl(x, 64 - k)
}

// 64 位位序反转
function bits_reverse(int x) -> int {
    int r = 0
    for (int i = 0; i < 64; i = i + 1) {
        r = r << 1
        if (((x >> i) & 1) == 1) { r = r | 1 }
    }
    return r
}

// 区间掩码 [lo, hi] (0 <= lo <= hi <= 63)
function bits_range_mask(int lo, int hi) -> int {
    if (lo < 0 || hi > 63 || hi < lo) { return 0 }
    return ((1 << (hi - lo + 1)) - 1) << lo
}

// 取出区间 [lo, hi] 并右移到最低位
function bits_extract(int x, int lo, int hi) -> int {
    if (lo < 0 || hi > 63 || hi < lo) { return 0 }
    return (x >> lo) & ((1 << (hi - lo + 1)) - 1)
}

// 把区间 [lo, hi] 替换为 v 的低位
function bits_insert(int x, int lo, int hi, int v) -> int {
    if (lo < 0 || hi > 63 || hi < lo) { return x }
    int width = hi - lo + 1
    int clear = ~bits_range_mask(lo, hi)
    int bits = (v & ((1 << width) - 1)) << lo
    return (x & clear) | bits
}

// 字节序翻转 (bswap64)
function bits_bswap(int x) -> int {
    int r = 0
    for (int i = 0; i < 8; i = i + 1) {
        r = r << 8
        r = r | ((x >> (i * 8)) & 0xFF)
    }
    return r
}
