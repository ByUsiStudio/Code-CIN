// Code CIN 官方标准库: 时间工具 (time)
// 用法: import "time.cin"
// 依赖内建: time()

// 当前 Unix 时间戳 (秒)
function t_now() -> int {
    return time()
}

// 两位左补零
function t_two(int v) -> string {
    if (v < 0) { v = -v }
    if (v < 10) { return "0" + int_to_str(v) }
    return int_to_str(v)
}

// 秒 -> "HH:MM:SS"
function t_hms(int secs) -> string {
    if (secs < 0) { secs = -secs }
    int h = idiv(secs, 3600)
    int m = idiv(secs % 3600, 60)
    int s = secs % 60
    return t_two(h) + ":" + t_two(m) + ":" + t_two(s)
}

// 秒 -> "MM:SS"
function t_ms(int secs) -> string {
    if (secs < 0) { secs = -secs }
    return t_two(idiv(secs, 60)) + ":" + t_two(secs % 60)
}

// 天/时/分/秒 拆解, 存入 4 元素数组
function t_breakdown(int secs, int[] out) -> void {
    if (secs < 0) { secs = -secs }
    out[0] = idiv(secs, 86400)
    out[1] = idiv(secs % 86400, 3600)
    out[2] = idiv(secs % 3600, 60)
    out[3] = secs % 60
}

// 人性化时长 "1d 2h 3m 4s" (省略为 0 的高位单位)
function t_human(int secs) -> string {
    if (secs < 0) { secs = -secs }
    int d = idiv(secs, 86400)
    int h = idiv(secs % 86400, 3600)
    int m = idiv(secs % 3600, 60)
    int s = secs % 60
    string out = ""
    if (d > 0) { out = out + int_to_str(d) + "d " }
    if (d > 0 || h > 0) { out = out + int_to_str(h) + "h " }
    if (d > 0 || h > 0 || m > 0) { out = out + int_to_str(m) + "m " }
    out = out + int_to_str(s) + "s"
    return out
}

// ==================== 日历扩展 (UTC 民用历) ====================

// 私有: 向下取整除法 (b > 0), 负数时间戳也能落到正确的日期
function _t_floordiv(int a, int b) -> int {
    int q = idiv(a, b)
    if (a % b != 0 && a < 0) { q = q - 1 }
    return q
}

// 私有: 左补零到 4 位 (负年份保留负号, 不补零)
function _t_pad4(int v) -> string {
    if (v < 0) { return int_to_str(v) }
    string s = int_to_str(v)
    while (strlen(s) < 4) { s = "0" + s }
    return s
}

// 私有: Unix 秒 -> 民用历 UTC, out[0]=年 out[1]=月 out[2]=日
// 算法: Howard Hinnant 的 civil_from_days (以 1970-01-01 为第 0 天)
function _t_ymd(int secs, int[] out) -> void {
    int days = _t_floordiv(secs, 86400)
    int z = days + 719468
    int era = _t_floordiv(z, 146097)
    int doe = z - era * 146097
    int yoe = idiv(doe - idiv(doe, 1460) + idiv(doe, 36524) - idiv(doe, 146096), 365)
    int y = yoe + era * 400
    int doy = doe - (365 * yoe + idiv(yoe, 4) - idiv(yoe, 100))
    int mp = idiv(5 * doy + 2, 153)
    int d = doy - idiv(153 * mp + 2, 5) + 1
    int m = mp + 3
    if (m > 12) {
        m = m - 12
        y = y + 1
    }
    out[0] = y
    out[1] = m
    out[2] = d
}

// Unix 秒 -> "YYYY-MM-DD" (UTC)
function t_date_utc(int secs) -> string {
    int ymd[3]
    _t_ymd(secs, ymd)
    return _t_pad4(ymd[0]) + "-" + t_two(ymd[1]) + "-" + t_two(ymd[2])
}

// Unix 秒 -> ISO 8601 "YYYY-MM-DDTHH:MM:SSZ" (UTC)
function t_iso8601(int secs) -> string {
    int r = secs % 86400
    if (r < 0) { r = r + 86400 }
    return t_date_utc(secs) + "T" + t_hms(r) + "Z"
}

// 星期几: 0=周日 .. 6=周六 (1970-01-01 为周四)
function t_weekday(int secs) -> int {
    int days = _t_floordiv(secs, 86400)
    int w = (days + 4) % 7
    if (w < 0) { w = w + 7 }
    return w
}

// 是否闰年 (公历规则: 4 年一闰, 100 年不闰, 400 年再闰)
function t_is_leap(int year) -> int {
    if (year % 4 != 0) { return 0 }
    if (year % 100 != 0) { return 1 }
    if (year % 400 == 0) { return 1 }
    return 0
}

// 某年某月的天数 (月份不在 1..12 时返回 0)
function t_days_in_month(int year, int month) -> int {
    if (month < 1 || month > 12) { return 0 }
    int dm[12] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31}
    if (month == 2 && t_is_leap(year) == 1) { return 29 }
    return dm[month - 1]
}
