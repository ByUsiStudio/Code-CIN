// Code CIN 官方标准库: 方阵运算 (matrix)
// 用法: import "matrix.cin"
//
// 矩阵以**一维数组**行主序存放 (m[i*n + j] 表示第 i 行第 j 列),
// 因此可直接用 CIN 的 int[] 与固定数组, 无需动态内存。
// 所有 "_to" 形式把结果写入调用方提供的输出数组。

// 置零 / 单位阵
function mat_zero(int[] m, int n) -> void {
    for (int i = 0; i < n * n; i = i + 1) {
        m[i] = 0
    }
}

function mat_identity(int[] m, int n) -> void {
    for (int i = 0; i < n; i = i + 1) {
        for (int j = 0; j < n; j = j + 1) {
            if (i == j) {
                m[i * n + j] = 1
            } else {
                m[i * n + j] = 0
            }
        }
    }
}

// 逐元素取值
function mat_get(int[] m, int n, int i, int j) -> int {
    if (i < 0 || j < 0 || i >= n || j >= n) { return 0 }
    return m[i * n + j]
}

function mat_set(int[] m, int n, int i, int j, int v) -> void {
    if (i < 0 || j < 0 || i >= n || j >= n) { return }
    m[i * n + j] = v
}

// out = a + b
function mat_add(int[] a, int[] b, int[] out, int n) -> void {
    for (int i = 0; i < n * n; i = i + 1) {
        out[i] = a[i] + b[i]
    }
}

// out = a - b
function mat_sub(int[] a, int[] b, int[] out, int n) -> void {
    for (int i = 0; i < n * n; i = i + 1) {
        out[i] = a[i] - b[i]
    }
}

// out = a * k
function mat_scale(int[] a, int k, int[] out, int n) -> void {
    for (int i = 0; i < n * n; i = i + 1) {
        out[i] = a[i] * k
    }
}

// out = a × b (经典三重循环; out 不得与 a/b 为同一数组)
function mat_mul(int[] a, int[] b, int[] out, int n) -> void {
    for (int i = 0; i < n; i = i + 1) {
        for (int j = 0; j < n; j = j + 1) {
            int s = 0
            for (int k = 0; k < n; k = k + 1) {
                s = s + a[i * n + k] * b[k * n + j]
            }
            out[i * n + j] = s
        }
    }
}

// out = a^T
function mat_transpose(int[] a, int[] out, int n) -> void {
    for (int i = 0; i < n; i = i + 1) {
        for (int j = 0; j < n; j = j + 1) {
            out[j * n + i] = a[i * n + j]
        }
    }
}

// 迹 (对角线之和)
function mat_trace(int[] a, int n) -> int {
    int s = 0
    for (int i = 0; i < n; i = i + 1) {
        s = s + a[i * n + i]
    }
    return s
}

// 所有元素之和
function mat_sum(int[] a, int n) -> int {
    int s = 0
    for (int i = 0; i < n * n; i = i + 1) {
        s = s + a[i]
    }
    return s
}

// 是否相等
function mat_equals(int[] a, int[] b, int n) -> int {
    for (int i = 0; i < n * n; i = i + 1) {
        if (a[i] != b[i]) { return 0 }
    }
    return 1
}

// 是否为对称矩阵
function mat_is_symmetric(int[] a, int n) -> int {
    for (int i = 0; i < n; i = i + 1) {
        for (int j = i + 1; j < n; j = j + 1) {
            if (a[i * n + j] != a[j * n + i]) { return 0 }
        }
    }
    return 1
}

// 行列式 (拉普拉斯展开, 递归; 适合 n <= 6 的小矩阵)
function mat_det(int[] a, int n) -> int {
    if (n <= 0) { return 0 }
    if (n == 1) { return a[0] }
    if (n == 2) { return a[0] * a[3] - a[1] * a[2] }
    int minor[36]                      // (n-1)^2 <= 25 (n <= 6)
    int det = 0
    int sign = 1
    for (int j = 0; j < n; j = j + 1) {
        int k = 0
        for (int r = 1; r < n; r = r + 1) {
            for (int c = 0; c < n; c = c + 1) {
                if (c == j) { continue }
                minor[k] = a[r * n + c]
                k = k + 1
            }
        }
        int sub = mat_det(minor, n - 1)
        if (sign == 1) {
            det = det + a[j] * sub
        } else {
            det = det - a[j] * sub
        }
        sign = 0 - sign
    }
    return det
}

// 打印 (调试用, 每行一个方括号)
function mat_print(int[] a, int n) -> void {
    for (int i = 0; i < n; i = i + 1) {
        string line = "["
        for (int j = 0; j < n; j = j + 1) {
            line = line + int_to_str(a[i * n + j])
            if (j < n - 1) { line = line + " " }
        }
        println(line + "]")
    }
}

// ---------------- 追加: 行列和 / 单位阵 / 幂 / 伴随矩阵 ----------------

// 第 r 行的元素之和; r 越界返回 0
function mat_row_sum(int[] a, int n, int r) -> int {
    if (r < 0 || r >= n) { return 0 }
    int s = 0
    for (int j = 0; j < n; j = j + 1) {
        s = s + a[r * n + j]
    }
    return s
}

// 第 c 列的元素之和; c 越界返回 0
function mat_col_sum(int[] a, int n, int c) -> int {
    if (c < 0 || c >= n) { return 0 }
    int s = 0
    for (int i = 0; i < n; i = i + 1) {
        s = s + a[i * n + c]
    }
    return s
}

// 是否为单位阵 (对角线 1, 其余 0); n <= 0 视为单位阵返回 1
function mat_is_identity(int[] a, int n) -> int {
    for (int i = 0; i < n; i = i + 1) {
        for (int j = 0; j < n; j = j + 1) {
            if (i == j) {
                if (a[i * n + j] != 1) { return 0 }
            } else {
                if (a[i * n + j] != 0) { return 0 }
            }
        }
    }
    return 1
}

// out = a^e (快速幂); e < 0 视为 0, 即结果为单位阵
//   要求 n <= 8 (内部两个 8x8 的暂存区), n <= 0 或 n > 8 返回 0;
//   out 可以与 a 为同一数组 (内部先复制底矩阵)
function mat_pow(int[] a, int e, int[] out, int n) -> int {
    if (n <= 0 || n > 8) { return 0 }
    int base[64]
    int tmp[64]
    for (int i = 0; i < n * n; i = i + 1) {
        base[i] = a[i]
        out[i] = 0
    }
    mat_identity(out, n)
    int k = e
    if (k < 0) { k = 0 }
    while (k > 0) {
        if (k % 2 == 1) {
            mat_mul(out, base, tmp, n)
            for (int i = 0; i < n * n; i = i + 1) {
                out[i] = tmp[i]
            }
        }
        k = idiv(k, 2)
        if (k > 0) {
            mat_mul(base, base, tmp, n)
            for (int i = 0; i < n * n; i = i + 1) {
                base[i] = tmp[i]
            }
        }
    }
    return 1
}

// out = a 的伴随矩阵 (adjugate): out[i][j] = (-1)^(i+j) * det(去掉第 j 行第 i 列的余子式)
//   要求 n <= 6 (与 mat_det 的递归容量一致); n <= 0 或 n > 6 返回 0;
//   n == 1 时伴随矩阵为 [1]; out 不得与 a 为同一数组 (内部会读 a 再写 out)
function mat_adjugate(int[] a, int[] out, int n) -> int {
    if (n <= 0 || n > 6) { return 0 }
    if (n == 1) {
        out[0] = 1
        return 1
    }
    int minor[36]
    for (int i = 0; i < n; i = i + 1) {
        for (int j = 0; j < n; j = j + 1) {
            int k = 0
            for (int r = 0; r < n; r = r + 1) {
                if (r == j) { continue }
                for (int c = 0; c < n; c = c + 1) {
                    if (c == i) { continue }
                    minor[k] = a[r * n + c]
                    k = k + 1
                }
            }
            int v = mat_det(minor, n - 1)
            if ((i + j) % 2 == 1) { v = 0 - v }
            out[i * n + j] = v
        }
    }
    return 1
}
