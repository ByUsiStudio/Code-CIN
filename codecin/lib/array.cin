// Code CIN 官方标准库: 整数数组工具 (array)
// 用法: import "lib/array.cin"
// 约定: CIN 数组不携带长度, 需显式传入元素个数 n。

// 求和
function a_sum(int[] a, int n) -> int {
    int s = 0
    for (int i = 0; i < n; i = i + 1) { s = s + a[i] }
    return s
}

// 最大值 (n<=0 返回 0)
function a_max(int[] a, int n) -> int {
    if (n <= 0) { return 0 }
    int m = a[0]
    for (int i = 1; i < n; i = i + 1) { if (a[i] > m) { m = a[i] } }
    return m
}

// 最小值 (n<=0 返回 0)
function a_min(int[] a, int n) -> int {
    if (n <= 0) { return 0 }
    int m = a[0]
    for (int i = 1; i < n; i = i + 1) { if (a[i] < m) { m = a[i] } }
    return m
}

// 平均值 (返回 float)
function a_avg(int[] a, int n) -> float {
    if (n <= 0) { return 0.0 }
    return a_sum(a, n) / n
}

// 线性查找, 返回下标或 -1
function a_find(int[] a, int n, int v) -> int {
    for (int i = 0; i < n; i = i + 1) { if (a[i] == v) { return i } }
    return -1
}

// 是否包含
function a_contains(int[] a, int n, int v) -> int {
    if (a_find(a, n, v) >= 0) { return 1 }
    return 0
}

// 计数
function a_count(int[] a, int n, int v) -> int {
    int c = 0
    for (int i = 0; i < n; i = i + 1) { if (a[i] == v) { c = c + 1 } }
    return c
}

// 原地反转
function a_reverse(int[] a, int n) -> void {
    int i = 0
    int j = n - 1
    while (i < j) {
        int t = a[i]
        a[i] = a[j]
        a[j] = t
        i = i + 1
        j = j - 1
    }
}

// 全部填充为 v
function a_fill(int[] a, int n, int v) -> void {
    for (int i = 0; i < n; i = i + 1) { a[i] = v }
}

// 拷贝 n 个元素
function a_copy(int[] src, int[] dst, int n) -> void {
    for (int i = 0; i < n; i = i + 1) { dst[i] = src[i] }
}

// 最大值下标 (n<=0 返回 -1)
function a_index_of_max(int[] a, int n) -> int {
    if (n <= 0) { return -1 }
    int k = 0
    for (int i = 1; i < n; i = i + 1) { if (a[i] > a[k]) { k = i } }
    return k
}

// 最小值下标 (n<=0 返回 -1)
function a_index_of_min(int[] a, int n) -> int {
    if (n <= 0) { return -1 }
    int k = 0
    for (int i = 1; i < n; i = i + 1) { if (a[i] < a[k]) { k = i } }
    return k
}

// 区间和 [lo, hi)
function a_sum_range(int[] a, int lo, int hi) -> int {
    int s = 0
    for (int i = lo; i < hi; i = i + 1) { s = s + a[i] }
    return s
}

// 首次 >= v 的下标 (数组需有序), 无则 -1
function a_lower_bound(int[] a, int n, int v) -> int {
    for (int i = 0; i < n; i = i + 1) { if (a[i] >= v) { return i } }
    return -1
}
