// Code CIN 官方标准库: 随机工具 (rand)
// 用法: import "rand.cin"
// 说明: 基于内建 rand(); 需要可复现时先调用内建 srand(种子)。

// [lo, hi] 闭区间随机整数
function r_range(int lo, int hi) -> int {
    if (hi <= lo) { return lo }
    return lo + (rand() % (hi - lo + 1))
}

// 随机布尔
function r_bool() -> bool {
    return r_range(0, 1) == 1
}

// [0.0, 1.0) 随机浮点
function r_float() -> float {
    return rand() / 2147483648.0
}

// [lo, hi) 随机浮点
function r_float_range(float lo, float hi) -> float {
    return lo + r_float() * (hi - lo)
}

// 原地洗牌 (Fisher-Yates)
function r_shuffle(int[] a, int n) -> void {
    for (int i = n - 1; i > 0; i = i - 1) {
        int j = r_range(0, i)
        int t = a[i]
        a[i] = a[j]
        a[j] = t
    }
}

// 随机取一个元素
function r_choice(int[] a, int n) -> int {
    if (n <= 0) { return 0 }
    return a[r_range(0, n - 1)]
}

// 按权重概率返回 1 (p 为 0..100 的百分比)
function r_chance(int p) -> int {
    if (rand() % 100 < p) { return 1 }
    return 0
}
