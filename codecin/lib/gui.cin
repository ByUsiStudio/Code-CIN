// Code CIN 官方标准库: GUI 窗口封装 (gui)
// 用法: import "gui.cin"
//
// 依赖原生 Go 运行时 (Windows 用 Win32, Linux 用 X11); 其他平台与
// --no-native / --sandbox 下 gui_new 返回 -1, 所有函数优雅失败不崩溃。
//
// 绘图模型: g_new 成功后, 画布内建 (set_color / fill_rect / fill_circle /
// draw_line / draw_text) 直接画进窗口后备缓冲, 每次调用 g_update() 才呈现。
// **窗口打开期间不要再调用 canvas()** —— 它会把画布重新绑定为离屏画布,
// 窗口从此不再更新; g_clear / g_clear_rect 已用 g_active() 做了防护。
//
// 事件模型: 键盘事件与终端共用同一键码队列 (get_key / key_hit, 见 key.cin),
// 窗口获得焦点时按键会进入该队列; 关闭请求 (点 X / Alt+F4 / WM 删除协议)
// 由 g_closed() 报告, 主循环需主动检查。

// 窗口尺寸 (g_new 成功后记录, 供 g_clear 与离屏回退使用)
int g_w = 0
int g_h = 0

// 鼠标键位掩码 (mouse_button 返回值的位含义)
const int G_BTN_LEFT = 1
const int G_BTN_RIGHT = 2
const int G_BTN_MIDDLE = 4

// 打开窗口 (w/h 自动钳制到 1..4096); 成功返回 0, 失败 (无显示服务 /
// 平台不支持 / 已有窗口) 返回 -1。成功后画布内建直画窗口。
function g_new(int w, int h, string title) -> int {
    int r = gui_new(w, h, title)
    if (r == 0) {
        g_w = w
        g_h = h
    }
    return r
}

// 呈现当前帧 (处理事件 + 把后备缓冲上屏); 无窗口返回 -1。
function g_update() -> int {
    return gui_update()
}

// 关闭窗口 (画布保留, 仍可 save_png 导出); 恒返回 0。
function g_close() -> int {
    int r = gui_close()
    g_w = 0
    g_h = 0
    return r
}

// 用户是否已请求关闭 (点 X / Alt+F4): 1 是 / 0 否
function g_closed() -> int {
    return gui_closed()
}

// 窗口是否已打开: 1 是 / 0 否
function g_active() -> int {
    return gui_active()
}

// 整屏填色。窗口打开: 直画窗口; 未打开但调用过 g_new (后被 g_close 关闭):
// 回退离屏画布仍可 save_png; 从未指定尺寸: 返回 -1。
function g_clear(int rgb) -> int {
    if (g_active() == 1) {
        set_color(rgb)
        fill_rect(0, 0, g_w, g_h)
        return 0
    }
    if (g_w > 0) {
        canvas(g_w, g_h)
        set_color(rgb)
        fill_rect(0, 0, g_w, g_h)
        return 0
    }
    return -1
}

// 鼠标光标 x (窗口客户区坐标); 无窗口返回 -1
function g_mouse_x() -> int {
    return mouse_x()
}

// 鼠标光标 y (窗口客户区坐标); 无窗口返回 -1
function g_mouse_y() -> int {
    return mouse_y()
}

// 按住的鼠标键位掩码 (bit0 左 / bit1 右 / bit2 中); 无窗口返回 -1
function g_mouse_buttons() -> int {
    return mouse_button()
}

// 左键是否按住 (需窗口打开): 1 是 / 0 否
function g_mouse_left() -> int {
    if (g_active() == 0) { return 0 }
    if ((mouse_button() & G_BTN_LEFT) != 0) { return 1 }
    return 0
}

// 右键是否按住 (需窗口打开): 1 是 / 0 否
function g_mouse_right() -> int {
    if (g_active() == 0) { return 0 }
    if ((mouse_button() & G_BTN_RIGHT) != 0) { return 1 }
    return 0
}

// 中键是否按住 (需窗口打开): 1 是 / 0 否
function g_mouse_middle() -> int {
    if (g_active() == 0) { return 0 }
    if ((mouse_button() & G_BTN_MIDDLE) != 0) { return 1 }
    return 0
}
