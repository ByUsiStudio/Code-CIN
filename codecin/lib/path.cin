// Code CIN 官方标准库: 纯字符串路径工具 (path)
// 用法: import "path.cin"
// 前缀: path_
//
// 与 io.cin 的 io_join / io_basename / io_dirname 不同, 本库是**纯字符串**实现:
// 不访问文件系统, 也不调用任何宿主能力内建 (不使用内建 path_join / path_basename /
// path_dirname / path_abs / cwd / is_dir / file_exists ...)。
// 只使用非宿主内建: strlen / substr / strcmp / int_to_str。
//
// 命名冲突 (重要):
// path_join / path_basename / path_dirname 是**宿主能力内建名**, 编译器优先分派内建,
// 因此**同名用户函数永远不会被调用** (--no-native 下直接报 "host builtins ... require
// the native Go runtime")。本库把这三个纯字符串版本命名为
//   path_str_join / path_str_basename / path_str_dirname
// 其余函数名与任务规格完全一致 (path_sep_posix / path_is_sep / path_ext / path_stem /
// path_normalize / path_is_absolute / path_trim_sep / path_split_count /
// path_split_get / path_common_prefix / path_within / path_change_ext)。
//
// 分隔符: '/' 与 '\' 等价 (两种都识别), 路径总是按 Unix 风格 ('/') 输出。
// 容量常量:
//   PATH_MAX_PARTS = 128   规范化 / 分段时可处理的路径分段上限
//                          (请用 path_max_parts() 读取)
// 全局数据段 = path_parts_buf[128] = 1024 字节 (分段解析的寄存器/暂存区)。
// 局部固长数组只在 path_common_prefix 中出现 (2 * 128 槽), 无动态内存分配。
//
// 明确不支持 (与真实文件系统语义不同):
//   - UNC 路径 (\\server\share): 前导双反斜杠按普通分隔符处理, 会折叠成单个 '/',
//     不保留 UNC 语义;
//   - 盘符只做**字符串**识别 (path_is_absolute 认 "C:\.." 形式), 不做大小写折叠,
//     不校验盘符是否真实存在;
//   - path_normalize 的 ".." 只做字符串层面的折叠 (不访问文件系统, 不解析符号链接,
//     也不受真实目录结构约束): "a/../b" -> "b", 而超出根部的 ".." 被保留
//     ("/../a" -> "/a" 是因为 "/" 之上无处可退, 相对路径的 "../a" 保持 "../a");
//   - 尾随分隔符在规范化后被丢弃 ("./a/" -> "a");
//   - 空串被规范化为 "."。

const int PATH_MAX_PARTS = 128

string path_parts_buf[128]

// ---------------- 常量与小工具 ----------------

// POSIX 分隔符 "/"
function path_sep_posix() -> string {
    return "/"
}

// Windows 分隔符 "\" (单字节 92)
function path_sep_win() -> string {
    return "\\"
}

// 该字节编码是否为路径分隔符 ('/' = 47 或 '\' = 92); 是返回 1, 否返回 0
function path_is_sep(int ch) -> int {
    if (ch == 47 || ch == 92) { return 1 }
    return 0
}

// 规范化时可处理的分段上限 (常量 PATH_MAX_PARTS = 128)
function path_max_parts() -> int {
    return PATH_MAX_PARTS
}

// 把字符串切成路径分段, 结果写入全局数组 path_parts_buf (不返回值)。
// 连续分隔符视为一个, 尾随分隔符不产生空段, 返回分段个数 (<= PATH_MAX_PARTS;
// 超过上限的部分被丢弃)。全局数组尾部总是补 NULL, 便于调用方判断结束。
function path_parts_into(string p) -> int {
    int n = strlen(p)
    int c = 0
    int i = 0
    while (i < n) {
        if (path_is_sep(p[i]) == 1) {
            i = i + 1
            continue
        }
        int start = i
        while (i < n && path_is_sep(p[i]) == 0) {
            i = i + 1
        }
        if (c < PATH_MAX_PARTS) {
            path_parts_buf[c] = substr(p, start, i - start)
            c = c + 1
        }
    }
    if (c < PATH_MAX_PARTS) { path_parts_buf[c] = "" }
    return c
}

// 路径分段个数: "a/b/c" -> 3, "" / "/" / "///" -> 0, "a" -> 1.
// 连续分隔符与尾随分隔符都不产生空段 (与 path_split_get 使用同一套分段规则)
function path_split_count(string p) -> int {
    return path_parts_into(p)
}

// 第 idx 段 (0 起); 越界 (含负数) 返回 ""
function path_split_get(string p, int idx) -> string {
    if (idx < 0) { return "" }
    int c = path_parts_into(p)
    if (idx >= c) { return "" }
    return path_parts_buf[idx]
}

// ---------------- 取最后一段 / 前缀 / 扩展名 ----------------

// 最后一段 (文件名); "" 与 "/" 返回 "", "a/b/" 返回 "b" (折叠尾随分隔符)。
// 纯字符串版本: 内建 path_basename 是宿主能力, 故本函数名为 path_str_basename
function path_str_basename(string p) -> string {
    int c = path_parts_into(p)
    if (c == 0) { return "" }
    return path_parts_buf[c - 1]
}

// 去掉最后一段, 结果**不带**尾随分隔符 (root 除外):
//   "/a/b/c.txt" -> "/a/b", "a" -> "", "/a" -> "/", "" -> "".
// 不做 "." / ".." 折叠 (用 path_normalize 做)。纯字符串版本 (内建 path_dirname 是宿主能力)
function path_str_dirname(string p) -> string {
    int c = path_parts_into(p)
    if (c == 0) { return "" }
    if (c == 1) {
        if (path_is_absolute(p) == 1) { return "/" }
        return ""
    }
    string out = path_parts_buf[0]
    for (int i = 1; i < c - 1; i = i + 1) {
        out = out + "/" + path_parts_buf[i]
    }
    string head = substr(p, 0, 1)
    if (path_is_sep(head[0]) == 1) { return "/" + out }
    return out
}

// 扩展名 (**含点**): "a/b/c.txt" -> ".txt"。
// 无扩展名返回 "": 没有点、点在最前 (隐藏文件 ".gitignore")、以及 "." / ".." 都返回 ""。
// 点在最后 ("a.") 视为"扩展名就是点本身", 返回 "."; 只看最后一段 (目录里的点不算)
function path_ext(string p) -> string {
    string b = path_str_basename(p)
    int lb = strlen(b)
    if (lb < 1) { return "" }
    if (strcmp(b, ".") == 0 || strcmp(b, "..") == 0) { return "" }
    int dot = -1
    for (int i = 0; i < lb; i = i + 1) {
        if (b[i] == 46) { dot = i }
    }
    if (dot < 1) { return "" }
    return substr(b, dot, lb - dot)
}

// 去掉扩展名的最后一段 (不含目录): "a/b/c.txt" -> "c", ".gitignore" -> ".gitignore",
// "a." -> "a", "." -> ".", "a/b/" -> "b"
function path_stem(string p) -> string {
    string b = path_str_basename(p)
    int lb = strlen(b)
    if (lb < 1) { return "" }
    if (strcmp(b, ".") == 0 || strcmp(b, "..") == 0) { return b }
    int dot = -1
    for (int i = 0; i < lb; i = i + 1) {
        if (b[i] == 46) { dot = i }
    }
    if (dot < 1) { return b }
    return substr(b, 0, dot)
}

// ---------------- 拼接 / 规范化 ----------------

// 拼接两个路径 (智能分隔符):
//   - a 为空返回 b; b 为空返回 a (都不折叠尾部/前导分隔符);
//   - 两侧都不为空: a 末尾已有分隔符则不重复添加, 否则补一个 '/';
//   - b 是绝对路径 ("/x" 或 "C:\x") 时忽略 a, 直接返回 b;
//   - 两侧都为空返回 ""
// 纯字符串版本: 内建 path_join 是宿主能力 (用系统分隔符), 故本函数名为 path_str_join
function path_str_join(string a, string b) -> string {
    if (strlen(a) == 0) { return b }
    if (strlen(b) == 0) { return a }
    if (path_is_absolute(b) == 1) { return b }
    int last = a[strlen(a) - 1]
    if (path_is_sep(last) == 1) { return a + b }
    return a + "/" + b
}

// 字符串层面的路径规范化 (不访问文件系统):
//   - 折叠重复分隔符: "a//b" -> "a/b"
//   - 去掉 "." 段: "a/./b" -> "a/b"
//   - ".." 回退上一个段: "a/b/../c" -> "a/c"; 无处可退时保留 ("../a" -> "../a",
//     但 "/.." -> "/" 因为根之上没有目录)
//   - 保留前导分隔符 (绝对路径): "//a/b" -> "/a/b"
//   - 丢掉尾随分隔符 (root 除外): "a/b/" -> "a/b"
//   - 空串、"."、"///" 规范化为 "."; 超出 PATH_MAX_PARTS 段的部分被丢弃
//   - 分隔符统一输出为 '/'
function path_normalize(string p) -> string {
    int absolute = 0
    if (strlen(p) > 0 && path_is_sep(p[0]) == 1) { absolute = 1 }
    int n = strlen(p)
    int i = 0
    if (absolute == 1) { i = 1 }
    int count = 0
    while (i < n) {
        if (path_is_sep(p[i]) == 1) {
            i = i + 1
            continue
        }
        int start = i
        while (i < n && path_is_sep(p[i]) == 0) {
            i = i + 1
        }
        string part = substr(p, start, i - start)
        if (strcmp(part, ".") == 0) {
            continue
        }
        if (strcmp(part, "..") == 0) {
            if (count > 0 && strcmp(path_parts_buf[count - 1], "..") != 0) {
                count = count - 1
            } else if (absolute == 0 && count < PATH_MAX_PARTS) {
                path_parts_buf[count] = part
                count = count + 1
            }
            continue
        }
        if (count < PATH_MAX_PARTS) {
            path_parts_buf[count] = part
            count = count + 1
        }
    }
    if (count == 0) {
        if (absolute == 1) { return "/" }
        return "."
    }
    string out = path_parts_buf[0]
    for (int k = 1; k < count; k = k + 1) {
        out = out + "/" + path_parts_buf[k]
    }
    if (absolute == 1) { return "/" + out }
    return out
}

// 是否绝对路径: 以 '/' 或 '\' 开头 ("/a"、"\\a") 返回 1;
// 盘符形式 "C:\a"、"C:/a"、"c:" 也返回 1 (第二个字符是 ':' 即算, 不校验字母范围)
function path_is_absolute(string p) -> int {
    int n = strlen(p)
    if (n == 0) { return 0 }
    if (path_is_sep(p[0]) == 1) { return 1 }
    if (n >= 2 && p[1] == 58) { return 1 }
    return 0
}

// 去掉首尾分隔符: "/a/b/" -> "a/b", "a" -> "a", "/" -> "", "///" -> ""。
// 中间的重复分隔符不折叠 (用 path_normalize 折叠)
function path_trim_sep(string p) -> string {
    int n = strlen(p)
    int s = 0
    while (s < n && path_is_sep(p[s]) == 1) {
        s = s + 1
    }
    int e = n
    while (e > s && path_is_sep(p[e - 1]) == 1) {
        e = e - 1
    }
    if (e <= s) { return "" }
    return substr(p, s, e - s)
}

// ---------------- 前缀 / 包含判断 ----------------

// 最长公共**分段**前缀 (不会把 "foo" 与 "foobar" 当成公共前缀):
//   path_common_prefix("/a/b/c", "/a/b/d") = "/a/b"
//   path_common_prefix("a/b", "a")        = "a"
//   path_common_prefix("x/y", "z/y")      = ""
//   path_common_prefix("/a", "/a")        = "/a"
// 绝对路径与相对路径不可能指向同一目录, 因此两者一侧绝对、另一侧相对时返回 ""
// (即使分段相同: path_common_prefix("/a", "a") = "")。
// 结果带前导 '/' 仅当前缀是 POSIX 根形式; 盘符路径保留盘符段本身
// (path_common_prefix("C:\a\b", "C:\a\c") = "C:/a")。
// 结果不带尾随分隔符; 无公共分段返回 ""
function path_common_prefix(string a, string b) -> string {
    int absa = path_is_absolute(a)
    if (absa != path_is_absolute(b)) { return "" }
    int posix = 0
    if (absa == 1 && path_is_sep(a[0]) == 1) { posix = 1 }
    int na = path_parts_into(a)
    string sa[PATH_MAX_PARTS]
    for (int i = 0; i < na; i = i + 1) {
        sa[i] = path_parts_buf[i]
    }
    // 注意: 第二次 path_parts_into 会覆盖全局数组 path_parts_buf,
    // 因此第一侧的分段必须先拷进本地数组 sa (本地固长数组不清零, 只读已写入的 0..na-1)。
    int nb = path_parts_into(b)
    string sb[PATH_MAX_PARTS]
    for (int j = 0; j < nb; j = j + 1) {
        sb[j] = path_parts_buf[j]
    }
    int c = 0
    while (c < na && c < nb) {
        if (strcmp(sa[c], sb[c]) != 0) { break }
        c = c + 1
    }
    if (c == 0) { return "" }
    string out = sa[0]
    for (int k = 1; k < c; k = k + 1) {
        out = out + "/" + sa[k]
    }
    if (posix == 1) { return "/" + out }
    return out
}

// child 是否位于 parent 之内 (1/0)。纯字符串判断, 按**分段边界**比较 (不做字符串前缀,
// 因此 "/a/b" 不包含 "/a/bc"), 两种分隔符与尾随分隔符都按同一段处理
// ("a/" 与 "a\\b" 视为 a 之下):
//   path_within("/a/b", "/a/b/c.txt") = 1
//   path_within("/a/b", "/a/bc")      = 0   (不是分段前缀)
//   path_within("/a/b", "/a/b")       = 1   (相等也算在内)
//   path_within("", "a/b")            = 0
//   path_within("/", "/a/b")          = 1   (root 包含一切绝对路径)
//   path_within("/", "a/b")           = 0   (绝对不包含相对)
// parent 的分段必须与 child 的**开头若干段逐一相同** (大小写敏感)
function path_within(string parent, string child) -> int {
    if (strlen(parent) == 0) { return 0 }
    int pabs = path_is_absolute(parent)
    if (path_is_absolute(child) != pabs) { return 0 }
    if (strcmp(path_trim_sep(parent), "") == 0) { return pabs }
    int np = path_parts_into(parent)
    string pc[PATH_MAX_PARTS]
    for (int i = 0; i < np; i = i + 1) {
        pc[i] = path_parts_buf[i]
    }
    // 第二次 path_parts_into 覆盖全局数组, 所以 parent 的分段必须已拷进 pc
    int nc = path_parts_into(child)
    if (np > nc) { return 0 }
    for (int k = 0; k < np; k = k + 1) {
        if (strcmp(pc[k], path_parts_buf[k]) != 0) { return 0 }
    }
    return 1
}

// ---------------- 替换扩展名 ----------------

// 替换 (或补上) 最后一段的扩展名。
//   - newext 允许带点或不带点: path_change_ext("a.txt", "md") 与
//     path_change_ext("a.txt", ".md") 都得到 "a.md";
//   - newext 为空串 -> 删除扩展名 ("a.txt" -> "a");
//   - 目标没有扩展名时补上 ("a/b" + ".txt" -> "a/b.txt");
//   - "." / ".." / "" 这类基名不做扩展名替换, 直接返回原路径 (空串也原样返回);
//   - 以分隔符结尾的路径 (目录形式, 如 "/a/b/") 原样返回, 不当作文件名;
//   - 目录部分原样保留: 只丢掉**尾随**分隔符再拼回去 ("a/b/c.txt" -> "a/b/c.md"),
//     中间的重复分隔符不折叠 (用 path_normalize 折叠)
function path_change_ext(string p, string newext) -> string {
    int n = strlen(p)
    if (n == 0) { return p }
    if (path_is_sep(p[n - 1]) == 1) { return p }
    string b = path_str_basename(p)
    int lb = strlen(b)
    if (strcmp(b, ".") == 0 || strcmp(b, "..") == 0) { return p }
    int dot = -1
    for (int i = 0; i < lb; i = i + 1) {
        if (b[i] == 46) { dot = i }
    }
    if (dot < 1) { dot = lb }
    string stem = substr(b, 0, dot)
    string ext = newext
    if (strlen(ext) > 0 && ext[0] != 46) { ext = "." + ext }
    // 最后一段的起点 = 最后一个分隔符之后; 目录部分原样保留, 只是丢掉尾随分隔符
    int cut = 0
    for (int k = 0; k < n; k = k + 1) {
        if (path_is_sep(p[k]) == 1) { cut = k + 1 }
    }
    string dir = substr(p, 0, cut)
    string keep = ""
    if (path_is_sep(dir[0]) == 1) { keep = "/" }
    string body = path_trim_sep(dir)
    if (strlen(body) > 0) { return keep + body + "/" + stem + ext }
    if (path_is_absolute(p) == 1) { return "/" + stem + ext }
    return stem + ext
}
