// Code CIN 官方标准库: Go 标准库兼容层 (gostd)
// 用法: import "gostd.cin"
//
// 以 pkg.Func 命名习惯提供 strings / strconv / math / slices / os 的
// 常用函数 (go_strings_contains 对应 strings.Contains)。命名里的包段
// 与 Go 文档一一对应, 便于从 Go 移植或查阅语义。
// 注意: go_os_args_len / go_os_args_get 依赖命令行参数内建 (arg_count /
// arg, SYS 129..130), 需要原生路径 (CLI `--` 传参或 AOT 产物 os.Args)。

// ==================== strings ====================

// strings.Contains
function go_strings_contains(string s, string sub) -> int {
    if (indexof(s, sub) >= 0) { return 1 }
    return 0
}

// strings.Index: 未找到 -1 (与 Go 语义一致)
function go_strings_index(string s, string sub) -> int {
    return indexof(s, sub)
}

// strings.ContainsAny 的单字符特例: s 是否含任一 ch 中字符
function go_strings_contains_any(string s, string chars) -> int {
    int n = strlen(chars)
    for (int i = 0; i < n; i = i + 1) {
        if (indexof(s, substr(chars, i, 1)) >= 0) { return 1 }
    }
    return 0
}

// strings.HasPrefix / strings.HasSuffix
function go_strings_has_prefix(string s, string prefix) -> int {
    int sl = strlen(s)
    int pl = strlen(prefix)
    if (pl > sl) { return 0 }
    if (strcmp(substr(s, 0, pl), prefix) == 0) { return 1 }
    return 0
}

function go_strings_has_suffix(string s, string suffix) -> int {
    int sl = strlen(s)
    int fl = strlen(suffix)
    if (fl > sl) { return 0 }
    if (strcmp(substr(s, sl - fl, fl), suffix) == 0) { return 1 }
    return 0
}

// strings.ToUpper / strings.ToLower / strings.TrimSpace
function go_strings_to_upper(string s) -> string {
    return upper(s)
}

function go_strings_to_lower(string s) -> string {
    return lower(s)
}

function go_strings_trim_space(string s) -> string {
    return trim(s)
}

// strings.Repeat
function go_strings_repeat(string s, int n) -> string {
    string out = ""
    while (n > 0) {
        out = out + s
        n = n - 1
    }
    return out
}

// strings.Count: 非重叠子串计数
function go_strings_count(string s, string sub) -> int {
    int sl = strlen(s)
    int nl = strlen(sub)
    if (nl == 0) { return sl + 1 }
    int total = 0
    int pos = 0
    while (pos <= sl) {
        int at = indexof(substr(s, pos, sl), sub)
        if (at < 0) { break }
        total = total + 1
        pos = pos + at + nl
    }
    return total
}

// strings.ReplaceAll
function go_strings_replace_all(string s, string oldstr, string newstr) -> string {
    int sl = strlen(s)
    int ol = strlen(oldstr)
    if (ol == 0) { return s }
    string out = ""
    int pos = 0
    while (pos <= sl) {
        string rest = substr(s, pos, sl)
        int at = indexof(rest, oldstr)
        if (at < 0) { break }
        out = out + substr(s, pos, at) + newstr
        pos = pos + at + ol
    }
    out = out + substr(s, pos, sl)
    return out
}

// strings.EqualFold 的 ASCII 精确版 (大小写不敏感相等)
function go_strings_equal_fold(string a, string b) -> int {
    if (strcmp(upper(a), upper(b)) == 0) { return 1 }
    return 0
}

// strings.Compare: <0 / 0 / >0
function go_strings_compare(string a, string b) -> int {
    return strcmp(a, b)
}

// len(s): 字节长度
function go_len(string s) -> int {
    return strlen(s)
}

// ==================== strconv ====================

// strconv.Itoa
function go_itoa(int v) -> string {
    return int_to_str(v)
}

// strconv.Atoi (解析失败为 0, 与内建 atoi 一致)
function go_atoi(string s) -> int {
    return atoi(s)
}

// strconv.FormatFloat 的默认精度替身
function go_format_float(float v) -> string {
    return float_to_str(v)
}

// ==================== math ====================

// math.Abs
function go_math_abs(int x) -> int {
    if (x < 0) { return -x }
    return x
}

// math.Max / math.Min (整数版)
function go_math_max(int a, int b) -> int {
    if (a > b) { return a }
    return b
}

function go_math_min(int a, int b) -> int {
    if (a < b) { return a }
    return b
}

// math.Floor / math.Ceil / math.Sqrt / math.Pow
function go_math_floor(float x) -> float {
    return floor(x)
}

function go_math_ceil(float x) -> float {
    return ceil(x)
}

function go_math_sqrt(float x) -> float {
    return sqrt(x)
}

function go_math_pow(float x, float y) -> float {
    return pow(x, y)
}

// ==================== slices ====================

// slices.Index: 未找到 -1
function go_slices_index(int[] a, int n, int x) -> int {
    for (int i = 0; i < n; i = i + 1) {
        if (a[i] == x) { return i }
    }
    return -1
}

// slices.Contains
function go_slices_contains(int[] a, int n, int x) -> int {
    if (go_slices_index(a, n, x) >= 0) { return 1 }
    return 0
}

// slices.Max / slices.Min / slices.Sum
function go_slices_max(int[] a, int n) -> int {
    if (n <= 0) { return 0 }
    int m = a[0]
    for (int i = 1; i < n; i = i + 1) {
        if (a[i] > m) { m = a[i] }
    }
    return m
}

function go_slices_min(int[] a, int n) -> int {
    if (n <= 0) { return 0 }
    int m = a[0]
    for (int i = 1; i < n; i = i + 1) {
        if (a[i] < m) { m = a[i] }
    }
    return m
}

function go_slices_sum(int[] a, int n) -> int {
    int s = 0
    for (int i = 0; i < n; i = i + 1) { s = s + a[i] }
    return s
}

// slices.Reverse (原地)
function go_slices_reverse(int[] a, int n) -> void {
    int lo = 0
    int hi = n - 1
    while (lo < hi) {
        int t = a[lo]
        a[lo] = a[hi]
        a[hi] = t
        lo = lo + 1
        hi = hi - 1
    }
}

// ==================== os (命令行参数) ====================
// 依赖原生路径 (CLI `--` 之后传参 / AOT 产物取 os.Args[1:])

// len(os.Args)
function go_os_args_len() -> int {
    return arg_count()
}

// os.Args[i] (越界为空串; Go 语义下标从 0 计 CIN 参数)
function go_os_args_get(int i) -> string {
    return arg(i)
}

// ==================== strings 扩展 ====================

// strings.LastIndex: 末现下标 (未找到 -1)
function go_strings_last_index(string s, string sub) -> int {
    int sl = strlen(s)
    int nl = strlen(sub)
    if (nl == 0) { return sl }
    int pos = sl - nl
    while (pos >= 0) {
        if (strcmp(substr(s, pos, nl), sub) == 0) { return pos }
        pos = pos - 1
    }
    return -1
}

// strings.IndexAny: chars 中任一字符在 s 的首现下标 (未找到 -1)
function go_strings_index_any(string s, string chars) -> int {
    int n = strlen(s)
    for (int i = 0; i < n; i = i + 1) {
        if (indexof(chars, substr(s, i, 1)) >= 0) { return i }
    }
    return -1
}

// strings.TrimLeft: 去掉前导的 cutset 内字符 (空 cutset 原样返回)
function go_strings_trim_left(string s, string cutset) -> string {
    if (strlen(cutset) == 0) { return s }
    int n = strlen(s)
    int i = 0
    while (i < n) {
        if (indexof(cutset, substr(s, i, 1)) < 0) { break }
        i = i + 1
    }
    return substr(s, i, n)
}

// strings.TrimRight: 去掉尾部的 cutset 内字符 (空 cutset 原样返回)
function go_strings_trim_right(string s, string cutset) -> string {
    if (strlen(cutset) == 0) { return s }
    int i = strlen(s) - 1
    while (i >= 0) {
        if (indexof(cutset, substr(s, i, 1)) < 0) { break }
        i = i - 1
    }
    return substr(s, 0, i + 1)
}

// strings.TrimPrefix: 有前缀则去掉 (无则原样)
function go_strings_trim_prefix(string s, string prefix) -> string {
    if (go_strings_has_prefix(s, prefix) == 1) {
        return substr(s, strlen(prefix), strlen(s))
    }
    return s
}

// strings.TrimSuffix: 有后缀则去掉 (无则原样)
function go_strings_trim_suffix(string s, string suffix) -> string {
    if (go_strings_has_suffix(s, suffix) == 1) {
        return substr(s, 0, strlen(s) - strlen(suffix))
    }
    return s
}

// ==================== strconv 扩展 ====================

// strconv.FormatInt: base 2..36 (越界按 10); 负数带 - 前缀。
// int64 最小值取负溢出的极端场景不保证 (CIN int 为 64 位补码)
function go_format_int(int v, int base) -> string {
    if (base < 2 || base > 36) { base = 10 }
    if (v == 0) { return "0" }
    string digits = "0123456789abcdefghijklmnopqrstuvwxyz"
    int neg = 0
    int x = v
    if (x < 0) { neg = 1 }
    string out = ""
    while (x != 0) {
        int d = x % base
        if (d < 0) { d = -d }
        out = substr(digits, d, 1) + out
        x = idiv(x, base)
    }
    if (neg == 1) { out = "-" + out }
    return out
}

// strconv.ParseInt 简化版: 允许可选 - 前缀, 数字 0-9 / a-z / A-Z,
// base 2..36 (越界按 10); 非法字符停在非法处 (与 conv.cin 风格一致, 非全有全无)
function go_parse_int(string s, int base) -> int {
    if (base < 2 || base > 36) { base = 10 }
    int n = strlen(s)
    int i = 0
    int neg = 0
    if (i < n && s[i] == 45) { neg = 1; i = i + 1 }   // '-'
    int v = 0
    while (i < n) {
        int c = s[i]
        int d = -1
        if (c >= 48 && c <= 57) {
            d = c - 48
        } else if (c >= 97 && c <= 122) {
            d = c - 87
        } else if (c >= 65 && c <= 90) {
            d = c - 55
        }
        if (d < 0 || d >= base) { break }
        v = v * base + d
        i = i + 1
    }
    if (neg == 1) { v = -v }
    return v
}

// ==================== math 扩展 ====================

// math.Round: 半值远离零 (与内建 round 的 floor(x+0.5) 在负半值上不同:
// go_math_round(-2.5) = -3, round(-2.5) = -2)
function go_math_round(float x) -> float {
    if (x >= 0.0) { return floor(x + 0.5) }
    return ceil(x - 0.5)
}

// math.Trunc: 向零截断
function go_math_trunc(float x) -> float {
    if (x >= 0.0) { return floor(x) }
    return ceil(x)
}

// ==================== slices 扩展 ====================

// slices.LastIndex: 末现下标 (未找到 -1)
function go_slices_last_index(int[] a, int n, int x) -> int {
    int i = n - 1
    while (i >= 0) {
        if (a[i] == x) { return i }
        i = i - 1
    }
    return -1
}

// slices.Equal: 前 n 个元素逐一相等
function go_slices_equal(int[] a, int[] b, int n) -> int {
    for (int i = 0; i < n; i = i + 1) {
        if (a[i] != b[i]) { return 0 }
    }
    return 1
}

// slices.Clone 的定长替身: 拷入调用方提供的 dst (CIN 无动态数组), 返回 n
function go_slices_clone(int[] dst, int[] src, int n) -> int {
    for (int i = 0; i < n; i = i + 1) { dst[i] = src[i] }
    return n
}

// slices.Sort (升序; CIN 无比较器参数, 固定升序)
function go_slices_sort(int[] a, int n) -> void {
    for (int i = 0; i < n - 1; i = i + 1) {
        for (int j = 0; j < n - 1 - i; j = j + 1) {
            if (a[j] > a[j + 1]) {
                int t = a[j]
                a[j] = a[j + 1]
                a[j + 1] = t
            }
        }
    }
}
