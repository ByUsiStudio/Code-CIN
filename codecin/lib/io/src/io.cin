// Code CIN 官方标准库: 文件与路径 (io)
// 用法: import "io.cin"
// 依赖内建: file_read / file_write / file_append / file_exists / file_size /
//           file_copy / file_move / dir_remove / is_dir / file_mtime / temp_dir /
//           chdir / path_abs / mkdir / dir_list ...
// 注意: 全部为 Go 原生能力 (需原生运行时; `--sandbox` 下宿主调用会被拦截)。
//
// 本库分两类:
//   * 文件系统/路径: 直接包装宿主内建 (真正访问磁盘), 失败返回 -1 / 空串;
//   * 纯字符串助手 (io_ext / io_stem / io_is_abs): 不访问文件系统, 可安全离线使用。

// 读取整个文本 (失败为空串)
function io_read(string path) -> string {
    return file_read(path)
}

// 覆盖写入 (0 成功 / -1 失败)
function io_write(string path, string text) -> int {
    return file_write(path, text)
}

// 追加写入
function io_append(string path, string text) -> int {
    return file_append(path, text)
}

// 是否存在
function io_exists(string path) -> int {
    return file_exists(path)
}

// 字节数 (-1 失败)
function io_size(string path) -> int {
    return file_size(path)
}

// 删除
function io_remove(string path) -> int {
    return file_delete(path)
}

// 递归创建目录
function io_mkdir(string path) -> int {
    return mkdir(path)
}

// 目录条目 (换行分隔; 目录名带 /)
function io_list(string path) -> string {
    return dir_list(path)
}

// 路径拼接 (自动补 /; 不处理 .. 归一化)
function io_join(string a, string b) -> string {
    if (strlen(a) == 0) { return b }
    if (strlen(b) == 0) { return a }
    int last = a[strlen(a) - 1]
    if (last == 47 || last == 92) { return a + b }
    return a + "/" + b
}

// 取路径最后一段 (文件名)
function io_basename(string path) -> string {
    int n = strlen(path)
    int cut = -1
    for (int i = 0; i < n; i = i + 1) {
        if (path[i] == 47 || path[i] == 92) { cut = i }
    }
    if (cut < 0) { return path }
    return substr(path, cut + 1, n - cut - 1)
}

// 取路径目录部分 (无分隔符返回 "")
function io_dirname(string path) -> string {
    int n = strlen(path)
    int cut = -1
    for (int i = 0; i < n; i = i + 1) {
        if (path[i] == 47 || path[i] == 92) { cut = i }
    }
    if (cut < 0) { return "" }
    return substr(path, 0, cut)
}

// 行数 (按 \n; 空串为 0)
function io_line_count(string text) -> int {
    int n = strlen(text)
    if (n == 0) { return 0 }
    int c = 1
    for (int i = 0; i < n; i = i + 1) {
        if (text[i] == 10) { c = c + 1 }
    }
    return c
}

// 取第 idx 行 (0 起, 不含换行符; 越界返回 "")
function io_get_line(string text, int idx) -> string {
    int n = strlen(text)
    int line = 0
    int start = 0
    for (int i = 0; i <= n; i = i + 1) {
        if (i == n || text[i] == 10) {
            if (line == idx) { return substr(text, start, i - start) }
            line = line + 1
            start = i + 1
        }
    }
    return ""
}

// 按分隔串切分, 返回第 idx 段 (0 起; 越界返回 "")
function io_split_get(string text, string sep, int idx) -> string {
    int sl = strlen(sep)
    if (sl == 0) { return idx == 0 ? text : "" }
    int n = strlen(text)
    int seg = 0
    int start = 0
    int i = 0
    while (i <= n - sl) {
        if (strcmp(substr(text, i, sl), sep) == 0) {
            if (seg == idx) { return substr(text, start, i - start) }
            seg = seg + 1
            i = i + sl
            start = i
            continue
        }
        i = i + 1
    }
    if (seg == idx) { return substr(text, start, n - start) }
    return ""
}

// 按分隔串切分的段数
function io_split_count(string text, string sep) -> int {
    int sl = strlen(sep)
    if (sl == 0) { return 1 }
    int n = strlen(text)
    int c = 1
    int i = 0
    while (i <= n - sl) {
        if (strcmp(substr(text, i, sl), sep) == 0) {
            c = c + 1
            i = i + sl
            continue
        }
        i = i + 1
    }
    return c
}

// ---------------- 文件系统扩展 (宿主内建薄封装) ----------------

// 复制文件 (0 成功 / -1 失败); 目标是覆盖写, 内容按字节复制
function io_copy(string src, string dst) -> int {
    return file_copy(src, dst)
}

// 移动/重命名 (0 成功 / -1 失败); 跨卷移动由系统实现, 失败返回 -1
function io_move(string src, string dst) -> int {
    return file_move(src, dst)
}

// 删除目录 (递归删除其下所有内容; 0 成功 / -1 失败)。
// 注意: 这是**递归**删除, 与只删除空目录的语义不同
function io_rmdir(string path) -> int {
    return dir_remove(path)
}

// 是否为目录 (1 是 / 0 否, 不存在也返回 0)
function io_is_dir(string path) -> int {
    return is_dir(path)
}

// 最后修改时间 (Unix 纪元秒; 失败 -1)
function io_mtime(string path) -> int {
    return file_mtime(path)
}

// 系统临时目录 (如 /tmp、%TEMP%); 失败为空串
function io_tmpdir() -> string {
    return temp_dir()
}

// 绝对路径 (基于当前工作目录; 失败为空串)。
// 分隔符由系统决定: Windows 返回 '\\' 形式 (与 io_join 的 '/' 风格不同),
// Linux/Android 返回 '/' 形式; 需要统一风格可再交给 io_join 或字符串处理
function io_abs(string path) -> string {
    return path_abs(path)
}

// 切换当前工作目录 (0 成功 / -1 失败); 影响后续相对路径的宿主调用
function io_chdir(string path) -> int {
    return chdir(path)
}

// ---------------- 纯字符串助手 (不访问文件系统) ----------------

// 扩展名 (**含点**): "a/b/c.txt" -> ".txt"; 无扩展名返回 ""。
// 没有点或点在最前 (隐藏文件 ".gitignore") 返回 ""; "." / ".." 返回 "";
// "a." 视为"扩展名就是点本身"返回 "."; 只看最后一段 (目录中的点不算)
function io_ext(string path) -> string {
    string b = io_basename(path)
    int lb = strlen(b)
    if (lb < 1) { return "" }
    if (strcmp(b, ".") == 0 || strcmp(b, "..") == 0) { return "" }
    int dot = -1
    for (int i = 0; i < lb; i = i + 1) {
        if (b[i] == 46) { dot = i }
    }
    if (dot < 1) { return "" }
    return substr(b, dot, lb - dot)
}

// 去掉扩展名的**最后一段** (不含目录): "a/b/c.txt" -> "c",
// ".gitignore" -> ".gitignore", "a." -> "a", "." / ".." 原样返回
function io_stem(string path) -> string {
    string b = io_basename(path)
    int lb = strlen(b)
    if (lb < 1) { return "" }
    if (strcmp(b, ".") == 0 || strcmp(b, "..") == 0) { return b }
    int dot = -1
    for (int i = 0; i < lb; i = i + 1) {
        if (b[i] == 46) { dot = i }
    }
    if (dot < 1) { return b }
    return substr(b, 0, dot)
}

// 是否绝对路径: 以 '/' 或 '\' 开头 ("/a"、"\\a"), 或盘符形式 "C:\a" / "c:"
// (第二个字节是 ':' 即算, 不校验盘符范围, 也不检查路径是否存在)
function io_is_abs(string path) -> int {
    int n = strlen(path)
    if (n == 0) { return 0 }
    int c = path[0]
    if (c == 47 || c == 92) { return 1 }
    if (n >= 2 && path[1] == 58) { return 1 }
    return 0
}
