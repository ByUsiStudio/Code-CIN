# ==================== 编辑器 / 系统 ====================
*.bak
.DS_Store
Thumbs.db

# ==================== Python ====================
__pycache__/
*.py[cod]
*.egg-info/
/.venv/
/venv/
/.pytest_cache/
/.pytest_tmp/
/.ruff_cache/
/pytest-cache-*
/pytest-tmp-*

# ==================== Go 构建缓存 ====================
/.gocache/
/.gotmp/

# ==================== 构建产物 ====================
/dist/
/build/
# 注: Go 侧不提供 CLI, 不存在 codecin/codecin.exe 之类的命令行产物。
# c-shared 原生库与生成的头文件 (由 build.ps1 / build.sh 生成, 不入库)
/codecin/*.dll
/codecin/*.so
/codecin/*.dylib
/codecin/*.h
/codecin/native/*.h

# ==================== 运行产物 / 临时文件 ====================
/*.crom
/*.png
/out_*.txt
/.tmp*
/t*.cin
# 汇编临时样例: 保留仓库内的 test_asm.asm (docs/BUILDING.md 的验收基准)
/test_*.asm
!/test_asm.asm

# ==================== AOT 构建产物 ====================
aotout/
# AOT 临时构建目录: build() 正常会删掉, 删不掉时至少不能污染 git 状态。
# (.aotprobe-* 是历史遗留前缀, 一并忽略; codecin/native/.gitignore 只覆盖该目录)
.aotbuild-*
.aotprobe-*
/aotcheck/

# ====================== Log ======================
*.log

# ====================== NPM ======================
# 本仓库的 npm 缓存被重定向到工作区内的 .npm-cache* (沙箱外缓存目录不可写)
.npm-cache*/

# ====================== Diag ======================
/diag*.py
/qrec_mvp.*

# ====================== Debug ======================
/.dsh_*.tmp
/t_*.py
/.trae/

# ====================== VSCode ======================
/misc/vscode-cin/*.vsix

# ====================== 其他临时 ======================
/.*/