# sdist 内容清单: 让内置标准库与 Go 侧源码都进入源码分发包。
# (wheel 侧由 pyproject.toml 的 [tool.setuptools.package-data] 负责)

include README.md CHANGELOG.md LICENSE
include pyproject.toml setup.py
recursive-include codecin/lib *.cin
recursive-include codecin/native *.go *.txt go.mod go.sum build.sh build.ps1
# 注: 不 include 预编译原生库 (*.dll/*.so/*.dylib) —— 它们在用户安装时由
# setup.py 现场编译, 见 pyproject.toml 的 package-data 说明。
# 注: 文档站已迁至独立仓库 Code-CIN-Docs, 本仓库不再有 docs/ —— 这里不收
# docs 内容, 以免本地残留的文档检出 (node_modules 里有大量 *.md) 被误打进 sdist。
# 注: Go 构建缓存 (AOT 构建器在只读 HOME 下的回退目录) 不属于源码。
prune codecin/native/.gocache
# 兜底: 任何本地编译出的预编译库都不得进入 sdist —— 即使 egg-info/SOURCES.txt
# 里残留了历史条目 (setuptools 会保留已存在文件的旧清单), 这里也强制排除。
global-exclude *.dll *.so *.dylib
recursive-include misc *
recursive-include examples *.cin *.asm *.pl
recursive-include script *.py
