// 三个兼容层库的冒烟测试 (临时, 验证后删除)
import "cstd.cin"
import "cppstd.cin"
import "gostd.cin"

function main() -> int {
    // libc
    println(libc_isdigit('7'))
    println(libc_toupper('a'))
    println(libc_fmod(7.5, 2.0))
    println(libc_strchr("hello", "l"))
    println(libc_strrchr("hello", "l"))
    println(libc_strncmp("hello", "help", 3))
    println(libc_strrev("abc"))
    println(libc_strcmp("a", "b"))
    int a[4] = {3, 1, 4, 1}
    libc_qsort_asc(a, 4)
    println(a[0])
    println(a[3])
    libc_memcpy(a, a, 2)
    println(a[1])

    // stl
    int v[8]
    int n = 0
    n = stl_vec_push_back(v, n, 5)
    n = stl_vec_push_back(v, n, 9)
    n = stl_vec_push_back(v, n, 2)
    println(n)
    println(stl_vec_back(v, n))
    n = stl_vec_pop_back(n)
    println(stl_vec_at(v, n, 0) + stl_vec_sum(v, n))
    stl_sort(v, n)
    println(v[0])
    string s = stl_str_append("foo", "bar")
    println(stl_str_find(s, "ob"))
    println(stl_str_rfind(s, "o"))
    println(stl_to_string(42))

    int st[4]
    int top = 0
    top = stl_stack_push(st, top, 1)
    top = stl_stack_push(st, top, 2)
    println(stl_stack_top(st, top))
    top = stl_stack_pop(top)
    println(stl_stack_size(top))

    int q[4]
    int head = 0
    int tail = 0
    tail = stl_queue_push(q, tail, 7)
    tail = stl_queue_push(q, tail, 8)
    println(stl_queue_front(q, head))
    head = stl_queue_pop(head)
    println(stl_queue_empty(head, tail))

    // gostd
    println(go_strings_contains("hello world", "wor"))
    println(go_strings_has_prefix("hello", "he"))
    println(go_strings_has_suffix("hello", "lo"))
    println(go_strings_repeat("ab", 3))
    println(go_strings_replace_all("a-b-c", "-", "+"))
    println(go_strings_count("banana", "an"))
    println(go_strings_equal_fold("Go", "go"))
    println(go_itoa(123) + "!")
    println(go_atoi("45"))
    println(go_math_abs(-5))
    println(go_math_min(3, 9))
    int g[3] = {4, 2, 6}
    println(go_slices_index(g, 3, 6))
    println(go_slices_contains(g, 3, 5))
    go_slices_reverse(g, 3)
    println(g[0])
    println(go_os_args_len())
    println(go_os_args_get(0))
    println(go_os_args_get(99))
    println(arg_count())
    println(arg(0))
    return 0
}
