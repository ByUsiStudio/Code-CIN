# 换行策略: 仓库统一 LF, 避免 Windows (core.autocrlf=true) 下
# 生成物被写成 CRLF, 导致 `gofmt -l` 误报与无意义的整文件 diff。
* text=auto eol=lf

*.go    text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.cin   text eol=lf
*.asm   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.vim   text eol=lf

# Windows 批处理必须 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制 (不参与换行转换与 diff)
*.dll   binary
*.so    binary
*.dylib binary
*.exe   binary
*.png   binary
