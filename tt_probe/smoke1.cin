import "text.cin"
import "token.cin"

function main() -> int {
    println("--text--")
    println(int_to_str(txt_is_empty("")))
    println(int_to_str(txt_equals_ignore_case("AbC", "aBc")))
    println(int_to_str(txt_startswith_ignore_case("Hello.cin", "heLLo")))
    println(txt_reverse("abcde"))
    println(txt_replace("banana", "na", "NA"))
    println(txt_replace_first("banana", "na", "NA"))
    println(txt_remove("a-b-c", "-"))
    println(int_to_str(txt_index_from("banana", "na", 3)))
    println(int_to_str(txt_last_index_of("aaaa", "aa")))
    println(txt_slice("abcdef", 1, 4))
    println(txt_insert("abc", 1, "XY"))
    println(txt_delete_range("abcdef", 1, 3))
    println(txt_capitalize("hELLO"))
    println(txt_title("tHE qUICK brown"))
    println(int_to_str(txt_word_count("  one   two  ")))
    println(txt_swap_case("Hello, World!"))
    println("--token--")
    println(int_to_str(tok_count("a,,b", ",")))
    println(tok_get("a,,b", ",", 1) + "|")
    println(int_to_str(tok_len("a,,b", ",", 1)))
    println(int_to_str(tok_find("a,,b", ",", "")))
    println(tok_first("a,,b", ",") + "|")
    println(tok_last("a,,b", ",") + "|")
    println(int_to_str(tok_word_count("  one   two  ")))
    println(tok_word_get("  one   two  ", 1))
    println("--bytes--")
    string zh = "\xE4\xB8\xAD\xE6\x96\x87"
    println(int_to_str(txt_index_from(zh, "\xE6\x96\x87", 0)))
    println(int_to_str(txt_last_index_of(zh, "\xE4\xB8\xAD")))
    println(txt_slice(zh, 0, 3))
    println(txt_insert(zh, 3, "x"))
    println(txt_capitalize(zh))
    println(txt_swap_case("\xE4\xB8\xADa"))
    println(tok_get(zh + "|" + "z", "|", 0))
    return 0
}
